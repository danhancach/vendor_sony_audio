soong_namespace {
}

android_app_import {
	name: "daxService",
	owner: "motorola",
	apk: "proprietary/system_ext/priv-app/daxService/daxService.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	system_ext_specific: true,
	privileged: true,
}

android_app_import {
	name: "MotoDolbyDax3",
	owner: "motorola",
	apk: "proprietary/system/app/MotoDolbyDax3/MotoDolbyDax3.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: true,
	},
	required: [
		"daxService",
	],
}

prebuilt_etc_xml {
	name: "dms-service.xml",
	owner: "motorola",
	src: "proprietary/vendor/etc/vintf/manifest/dms-service.xml",
	filename_from_src: true,
	sub_dir: "vintf/manifest",
	soc_specific: true,
}

prebuilt_etc_xml {
	name: "vendor.dolby.media.c2.v1.0@1.0-service.xml",
	owner: "motorola",
	src: "proprietary/vendor/etc/vintf/manifest/vendor.dolby.media.c2.v1.0@1.0-service.xml",
	filename_from_src: true,
	sub_dir: "vintf/manifest",
	soc_specific: true,
}

prebuilt_etc_xml {
	name: "vendor.dolby.vision.media.c2@1.0-service.xml",
	owner: "motorola",
	src: "proprietary/vendor/etc/vintf/manifest/vendor.dolby.vision.media.c2@1.0-service.xml",
	filename_from_src: true,
	sub_dir: "vintf/manifest",
	soc_specific: true,
}

cc_prebuilt_binary {
	name: "vendor.dolby.dms.service",
	owner: "motorola",
	strip: { none: true },
	target: {
		android_arm64: {
			srcs: ["proprietary/vendor/bin/hw/vendor.dolby.dms.service"],
		},
	},
	compile_multilib: "64",
	prefer: true,
	check_elf_files: false,
	relative_install_path: "hw",
	soc_specific: true,
}

