+status_t EffectModule::sendOffloadForPregain_l(audio_io_handle_t io)
+{
+    audio_utils::lock_guard _l(mutex());
+    if (mStatus != NO_ERROR) {
+        return mStatus;
+    }
+    if (mEffectInterface == nullptr) {
+        return NO_INIT;
+    }
+    effect_offload_param_t cmd = {};
+    cmd.isOffload = 0;
+    cmd.ioHandle = io;
+    status_t cmdStatus = NO_ERROR;
+    uint32_t size = sizeof(status_t);
+    status_t status = mEffectInterface->command(EFFECT_CMD_OFFLOAD,
+                                                sizeof(effect_offload_param_t),
+                                                &cmd,
+                                                &size,
+                                                &cmdStatus);
+    if (status == NO_ERROR) {
+        status = cmdStatus;
+    }
+    ALOGV("%s() io=%d status=%d", __func__, io, status);
+    return status;
+}
