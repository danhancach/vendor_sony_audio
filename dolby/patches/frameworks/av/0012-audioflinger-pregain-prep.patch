+}
+
+void EffectDapController::executePregainPrep_l(const sp<IAfPlaybackThread>& mlThread) {
+    sp<IAfPlaybackThread> dapThread = mDapPlaybackThread.promote();
+    if (dapThread == nullptr || mDapEffect == nullptr) {
+        return;
+    }
+    mPendingDapPregPrep = dapThread;
+    if (mlThread != nullptr) {
+        mPendingMlForResync = mlThread;
+    }
+    ALOGV("%s() scheduled on mix io=%d", __func__, dapThread->id());
+}
+
+void EffectDapController::runPregainPrepSync(const sp<IAfPlaybackThread>& mlThread,
+        const sp<IAfPlaybackThread>& dapThread) {
+    dapThread->prepareDapPregainForTrackThread(mlThread);
+    if (mlThread != nullptr) {
+        mlThread->prepareDapPregainResyncVolumes();
+        ALOGI("%s() mix io=%d track io=%d", __func__, dapThread->id(), mlThread->id());
+    }
+}
+
+void EffectDapController::onDapPregPrepComplete_l() {
+    sp<IAfPlaybackThread> mlThread = mPendingMlForResync.promote();
+    if (mlThread == nullptr) {
+        return;
+    }
+    mPendingMlVolumeResync = mlThread;
+    mPendingMlForResync.clear();
+}
+
+bool EffectDapController::runPendingDapPregainOnMixThread(
+        const sp<IAfPlaybackThread>& mixThread) {
+    sp<IAfPlaybackThread> trackThread;
+    {
+        Mutex::Autolock _l(mLock);
+        if (!consumePendingDapPregPrep_l(mixThread)) {
+            return false;
+        }
+        trackThread = mPendingMlForResync.promote();
+    }
+    mixThread->prepareDapPregainForTrackThread(trackThread);
+    Mutex::Autolock _l(mLock);
+    onDapPregPrepComplete_l();
+    return true;
+}
+
+void EffectDapController::preparePregainForMusicListener(
+        const sp<IAfPlaybackThread>& mlThread) {
+    if (mlThread == nullptr) {
+        return;
+    }
+    sp<IAfPlaybackThread> dapThread;
+    {
+        Mutex::Autolock _l(mLock);
+        dapThread = mDapPlaybackThread.promote();
+        if (dapThread == nullptr || mDapEffect == nullptr) {
+            mPendingMlPregPrep = mlThread;
+            ALOGI("%s() deferred until global DAP bound", __func__);
+            return;
+        }
+    }
+    if (!requestPregainPrep()) {
+        return;
+    }
+    runPregainPrepSync(mlThread, dapThread);
+}
+
+void EffectDapController::runDeferredPregainPrep() {
+    sp<IAfPlaybackThread> mlThread;
+    {
+        Mutex::Autolock _l(mLock);
+        mlThread = mPendingMlPregPrep.promote();
+        if (mlThread == nullptr || mDapEffect == nullptr ||
+                mDapPlaybackThread.promote() == nullptr) {
+            return;
+        }
+        mPendingMlPregPrep.clear();
+    }
+    if (!requestPregainPrep()) {
+        return;
+    }
+    ALOGV("%s() running deferred ML preg prep", __func__);
+    Mutex::Autolock _l(mLock);
+    executePregainPrep_l(mlThread);
+}
+
+void EffectDapController::onGlobalMixChainAttached(
+        const sp<IAfPlaybackThread>& thread,
+        const sp<IAfEffectChain>& chain) {
+    if (thread == nullptr || chain == nullptr) {
+        return;
+    }
+    const sp<IAfThreadBase> threadBase = thread;
+    {
+        Mutex::Autolock _l(mLock);
+        mDapPlaybackThread = thread;
+        for (size_t i = 0; i < chain->numberOfEffects(); ++i) {
+            const sp<IAfEffectModule> effect = chain->getEffectModule(i);
+            if (isDapEffect(effect)) {
+                mDapEffect = effect;
+                ALOGI("%s() global DAP bound to playback thread", __func__);
+                break;
+            }
+        }
+    }
+    connectDmsIfNeeded(threadBase);
+    runDeferredPregainPrep();
+}
+
+void EffectDapController::finishDapRestartOnHostThread() {
+    Mutex::Autolock _l(mLock);
+    finishDapRestartForPregain_l();
+}
+
+void EffectDapController::finishDapRestartForPregain_l() {
+    if (mDapEffect == nullptr) {
+        return;
+    }
+    status_t status = sendEffectIntParam(mDapEffect, EFFECT_PARAM_SKIP_HARD_BYPASS, 1);
+    if (status != NO_ERROR) {
+        ALOGW("%s() SKIP_HARD_BYPASS failed: %d", __func__, status);
+    }
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get(kDolbyEnabledProp, value, "0");
+    const bool dolbyOn = mDolbyHalOn || parseDolbyEnabledProp(value);
+    if (dolbyOn) {
+        setBypass_l(false);
+    }
+}
+
+bool EffectDapController::consumePendingMlVolumeResync(
+        const sp<IAfPlaybackThread>& thread) {
+    sp<IAfPlaybackThread> pending;
+    {
+        Mutex::Autolock _l(mLock);
+        pending = mPendingMlVolumeResync.promote();
+        if (pending == nullptr || pending.get() != thread.get()) {
+            return false;
+        }
+        mPendingMlVolumeResync.clear();
+    }
+    ALOGV("%s() ML volume resync on mixer frame", __func__);
+    return true;
+}
+
+bool EffectDapController::consumePendingDapPregPrep_l(
+        const sp<IAfPlaybackThread>& thread) {
+    sp<IAfPlaybackThread> pending = mPendingDapPregPrep.promote();
+    if (pending == nullptr || pending.get() != thread.get()) {
+        return false;
+    }
+    mPendingDapPregPrep.clear();
+    return true;
+}
