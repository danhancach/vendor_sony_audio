--- /dev/null
+++ b/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.h
@@ -0,0 +1,14 @@
+/*
+ * Sony/Moto Dolby routing: keep music on primary mixer (session-0 DAP), strip offload paths.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <system/audio.h>
+
+namespace android {
+
+bool sonyDolbyEnabled();
+void sonyDolbyAdjustOutputFlags(audio_stream_type_t stream, audio_output_flags_t* flags);
+
+} // namespace android
diff --git a/services/audiopolicy/managerdefault/dolby_debug.h b/services/audiopolicy/managerdefault/dolby_debug.h
new file mode 100644
index 0000000000..f597b37310
--- /dev/null
+++ b/services/audiopolicy/managerdefault/dolby_debug.h
@@ -0,0 +1,43 @@
+/*
+ * Shared Dolby debug helpers (session e9d9bf).
+ */
+#pragma once
+
+#include <cutils/properties.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <utils/Timers.h>
+
+namespace android {
+
+static inline bool dolbyDebugEnabled() {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.vendor.dolby.debug", value, "0");
+    return value[0] == '1' || value[0] == 't' || value[0] == 'T';
+}
+
+// #region agent log
+static inline void dolbyAgentLog(const char* location, const char* message,
+                                 const char* hypothesisId, const char* dataJson) {
+    if (!dolbyDebugEnabled()) {
+        return;
+    }
+    const char* path = "/data/local/tmp/debug-e9d9bf.log";
+    const int fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0644);
+    if (fd < 0) {
+        return;
+    }
+    char line[640];
+    const int n = snprintf(line, sizeof(line),
+            "{\"sessionId\":\"e9d9bf\",\"runId\":\"framework\",\"hypothesisId\":\"%s\","
+            "\"location\":\"%s\",\"message\":\"%s\",\"data\":%s,\"timestamp\":%lld}\n",
+            hypothesisId, location, message, dataJson,
+            static_cast<long long>(systemTime(SYSTEM_TIME_REALTIME) / 1000000));
+    if (n > 0) {
+        write(fd, line, static_cast<size_t>(n));
+    }
+    close(fd);
+}
+// #endregion agent log
+
+} // namespace android
