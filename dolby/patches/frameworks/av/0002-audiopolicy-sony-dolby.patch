diff --git a/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.cpp b/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.cpp
new file mode 100644
index 0000000000..110fc1819c
--- /dev/null
+++ b/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.cpp
@@ -0,0 +1,52 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#define LOG_TAG "SonyDolbyAudioPolicy"
+
+#include "SonyDolbyAudioPolicy.h"
+
+#include <cutils/properties.h>
+#include <strings.h>
+#include <utils/Log.h>
+
+#include "dolby_debug.h"
+
+namespace android {
+
+bool sonyDolbyEnabled() {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.audio.dolby.enabled", value, "1");
+    if (value[0] == '\0' || value[0] == '0') {
+        return false;
+    }
+    if (strcasecmp(value, "false") == 0) {
+        return false;
+    }
+    return true;
+}
+
+void sonyDolbyAdjustOutputFlags(audio_stream_type_t stream, audio_output_flags_t* flags) {
+    if (flags == nullptr || stream != AUDIO_STREAM_MUSIC) {
+        return;
+    }
+    if (!sonyDolbyEnabled()) {
+        return;
+    }
+    const audio_output_flags_t before = *flags;
+    // Route music through the primary mixer where session-0 DAP (getOutputForEffect) lives.
+    // Forcing DEEP_BUFFER sends playback to a separate io handle with no DAP effect chain.
+    *flags = static_cast<audio_output_flags_t>(
+            *flags & ~(AUDIO_OUTPUT_FLAG_DIRECT | AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD |
+                       AUDIO_OUTPUT_FLAG_FAST | AUDIO_OUTPUT_FLAG_HW_AV_SYNC |
+                       AUDIO_OUTPUT_FLAG_DEEP_BUFFER));
+    if (before != *flags) {
+        ALOGI("%s() dolby_enable=1 music flags 0x%x -> 0x%x", __func__, before, *flags);
+        // #region agent log
+        char data[96];
+        snprintf(data, sizeof(data), "{\"before\":%u,\"after\":%u}", before, *flags);
+        dolbyAgentLog("SonyDolbyAudioPolicy.cpp:adjust", "flags_adjusted", "H2", data);
+        // #endregion agent log
+    }
+}
+
+} // namespace android
diff --git a/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.h b/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.h
new file mode 100644
