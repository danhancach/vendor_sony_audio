+bool EffectDapController::isPlayingPkgPrioritized_l() const {
+    if (pkgInSomcList(mPlayingPkgName, mExcludedApps)) {
+        return false;
+    }
+    if (pkgInSomcList(mPlayingPkgName, mPrioritizedApps)) {
+        return true;
+    }
+    if (mPlayingPkgUid == static_cast<uid_t>(-1) || mPlayingPkgUid == 0) {
+        return false;
+    }
+    PermissionController permissionController;
+    for (const auto& pkg : mPrioritizedApps) {
+        const int pkgUid = permissionController.getPackageUid(String16(pkg.c_str()), 0);
+        if (pkgUid >= 0 && static_cast<uid_t>(pkgUid) == mPlayingPkgUid) {
+            return true;
+        }
+    }
+    return false;
+}
