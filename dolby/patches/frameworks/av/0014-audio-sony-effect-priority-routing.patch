+static std::vector<std::string> parseSomcPkgList(const char* list) {
+    std::vector<std::string> out;
+    if (list == nullptr || list[0] == '\0') {
+        return out;
+    }
+    const std::string s(list);
+    size_t start = 0;
+    for (size_t i = 0; i <= s.size(); ++i) {
+        if (i == s.size() || s[i] == ',' || s[i] == ';') {
+            if (i > start) {
+                std::string pkg = s.substr(start, i - start);
+                while (!pkg.empty() && pkg.front() == ' ') {
+                    pkg.erase(0, 1);
+                }
+                while (!pkg.empty() && pkg.back() == ' ') {
+                    pkg.pop_back();
+                }
+                if (!pkg.empty()) {
+                    out.push_back(pkg);
+                }
+            }
+            start = i + 1;
+        }
+    }
+    return out;
+}
+
+static bool pkgInSomcList(const std::string& pkg, const std::vector<std::string>& list) {
+    if (pkg.empty()) {
+        return false;
+    }
+    for (const auto& entry : list) {
+        if (entry == pkg) {
+            return true;
+        }
+    }
+    return false;
+}
+
