new file mode 100644
index 0000000000..81b6790b11
--- /dev/null
+++ b/services/audioflinger/SonyEffectPriorityApps.cpp
@@ -0,0 +1,123 @@
+/*
+ * Supplement audio_playback_effect_supported_apps_preset when Sony HAL returns empty.
+ * SoundEnhancement AppsManager.getPresetAppList() rejects lists whose size != 33.
+ */
+#define LOG_TAG "SonyEffectPriority"
+
+#include "SonyEffectPriorityApps.h"
+
+#include <log/log.h>
+
+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <media/AudioParameter.h>
+
+using android::AudioParameter;
+using android::NO_ERROR;
+using android::String8;
+
+constexpr const char* kPresetKey = "audio_playback_effect_supported_apps_preset";
+constexpr size_t kExpectedPresetAppCount = 33;
+constexpr const char* kWhiteListXmlPath = "/vendor/etc/audio_app_white_list.xml";
+constexpr const char* kPackageOpenTag = "<package-name>";
+constexpr const char* kPackageCloseTag = "</package-name>";
+
+std::mutex gPresetMutex;
+String8 gCachedPreset;
+
+size_t countCommaSeparated(const String8& value) {
+    if (value.size() == 0) {
+        return 0;
+    }
+    size_t count = 1;
+    for (size_t i = 0; i < value.size(); ++i) {
+        if (value[i] == ',') {
+            ++count;
+        }
+    }
+    return count;
+}
+
+bool presetValueUsable(const String8& value) {
+    return countCommaSeparated(value) == kExpectedPresetAppCount;
+}
+
+std::vector<std::string> parsePackageNamesFromXml(const std::string& content) {
+    std::vector<std::string> packages;
+    size_t pos = 0;
+    while (packages.size() < kExpectedPresetAppCount) {
+        const size_t start = content.find(kPackageOpenTag, pos);
+        if (start == std::string::npos) {
+            break;
+        }
+        const size_t nameStart = start + strlen(kPackageOpenTag);
+        const size_t end = content.find(kPackageCloseTag, nameStart);
+        if (end == std::string::npos) {
+            break;
+        }
+        packages.emplace_back(content.substr(nameStart, end - nameStart));
+        pos = end + strlen(kPackageCloseTag);
+    }
+    return packages;
+}
+
+String8 joinPackages(const std::vector<std::string>& packages) {
+    String8 joined;
+    for (size_t i = 0; i < packages.size(); ++i) {
+        if (i > 0) {
+            joined += ",";
+        }
+        joined += packages[i].c_str();
+    }
+    return joined;
+}
+
+String8 loadPresetFromXml() {
+    std::lock_guard<std::mutex> lock(gPresetMutex);
+    if (gCachedPreset.size() > 0) {
+        return gCachedPreset;
+    }
+
+    std::ifstream in(kWhiteListXmlPath);
+    if (!in) {
+        ALOGW("%s: cannot read %s", __func__, kWhiteListXmlPath);
+        return {};
+    }
+    std::string content((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+
+    const std::vector<std::string> packages = parsePackageNamesFromXml(content);
+    if (packages.size() != kExpectedPresetAppCount) {
+        ALOGW("%s: %zu packages in %s, expected %zu", __func__, packages.size(),
+              kWhiteListXmlPath, kExpectedPresetAppCount);
+        return {};
+    }
+
+    gCachedPreset = joinPackages(packages);
+    ALOGI("%s: loaded %zu preset apps from %s", __func__, packages.size(), kWhiteListXmlPath);
+    return gCachedPreset;
+}
+
+android::String8 sonySupplementEffectPriorityGetParameters(const android::String8& keys,
+                                                           const android::String8& halOut) {
+    if (keys != kPresetKey) {
+        return halOut;
+    }
+
+    AudioParameter param(halOut);
+    String8 value;
+    if (param.get(String8(kPresetKey), value) == NO_ERROR && presetValueUsable(value)) {
+        return halOut;
+    }
+
+    const String8 preset = loadPresetFromXml();
+    if (preset.size() == 0) {
+        return halOut;
+    }
+
+    ALOGI("%s: supplement HAL preset for SoundEnhancement UI", __func__);
+    return String8(kPresetKey) + "=" + preset;
+}
