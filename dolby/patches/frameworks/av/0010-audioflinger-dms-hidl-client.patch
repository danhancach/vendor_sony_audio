+size_t PlaybackThread::resyncDapEffectVolumes_l() {
+    size_t syncedTracks = 0;
+    constexpr float kScaleTo8_24 = static_cast<float>(1 << 24) * static_cast<float>(1 << 24);
+    for (const sp<IAfTrackBase>& trackBase : mActiveTracks) {
+        const sp<IAfTrack> track = trackBase->asIAfTrack();
+        if (track == nullptr) {
+            continue;
+        }
+        float left = 0.f;
+        float right = 0.f;
+        track->getFinalVolume(&left, &right);
+        uint32_t vl = static_cast<uint32_t>(kScaleTo8_24 * left);
+        uint32_t vr = static_cast<uint32_t>(kScaleTo8_24 * right);
+        sp<IAfEffectChain> chain = getEffectChain_l(track->sessionId());
+        if (chain != nullptr) {
+            chain->setVolume(&vl, &vr, true /* force */);
+            syncedTracks++;
+        }
+    }
+    return syncedTracks;
+}
