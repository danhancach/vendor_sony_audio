+          __func__, mEffectiveDolbyRoute ? 1 : 0, newDolbyRoute ? 1 : 0,
+          mEffectiveDseeRoute ? 1 : 0, newDseeRoute ? 1 : 0);
+    mEffectiveDolbyRoute = newDolbyRoute;
+    mEffectiveDseeRoute = newDseeRoute;
+    mInvalidateMusicAfterUnlock = true;
