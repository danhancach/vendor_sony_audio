+        property_get(kDolbyEnabledProp, value, "0");
+        const bool dolbyOn = mDolbyHalOn || parseDolbyEnabledProp(value);
+        if (halChanged && dolbyOn) {
+            // Routing stays on deep_buffer but PAL may latch DSEE on the open stream.
+            mInvalidateMusicAfterUnlock = true;
