                 flags, true /* directOnly */);
+    };
+
+    if (stream == AUDIO_STREAM_MUSIC && sonyUsesDseeRouting(mpClientInterface) &&
+            (flags & AUDIO_OUTPUT_FLAG_DIRECT) != 0 &&
+            (flags & AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD) == 0) {
