diff --git a/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.cpp b/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.cpp
new file mode 100644
index 0000000000..5759f68df5
--- /dev/null
+++ b/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.cpp
@@ -0,0 +1,234 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#define LOG_TAG "SonyDolbyAudioPolicy"
+
+#include "SonyDolbyAudioPolicy.h"
+#include "Sony360RAudioPolicy.h"
+
+#include <media/AudioParameter.h>
+#include <cutils/properties.h>
+#include <strings.h>
+#include <utils/Log.h>
+
+#include <cstring>
+
+#include "AudioPolicyInterface.h"
+
+namespace android {
+
+namespace {
+
+bool sonyParseHalBool(const AudioParameter& param, const char* key, bool* out) {
+    int value = 0;
+    if (param.getInt(String8(key), value) == NO_ERROR) {
+        *out = value != 0;
+        return true;
+    }
+    String8 str;
+    if (param.get(String8(key), str) == NO_ERROR) {
+        *out = str == "true" || str == "1";
+        return true;
+    }
+    return false;
+}
+
+bool sonyGetHalBool(AudioPolicyClientInterface* client, const char* key, bool* out) {
+    if (client == nullptr || key == nullptr || out == nullptr) {
+        return false;
+    }
+    const String8 result = client->getParameters(AUDIO_IO_HANDLE_NONE, String8(key));
+    if (result.length() == 0) {
+        return false;
+    }
+    return sonyParseHalBool(AudioParameter(result), key, out);
+}
+
+bool sonyGetHalInt(AudioPolicyClientInterface* client, const char* key, int* value) {
+    if (client == nullptr || key == nullptr || value == nullptr) {
+        return false;
+    }
+    const String8 result = client->getParameters(AUDIO_IO_HANDLE_NONE, String8(key));
+    if (result.length() == 0) {
+        return false;
+    }
+    AudioParameter param(result);
+    return param.getInt(String8(key), *value) == NO_ERROR;
+}
+
+// Stock: preset list + excluded override; HAL mirrors via isUpmixSupportedPkg /
+// is_dsee_prioritized for the current playing_pkg.
+bool sonySonyEffectWinsOverDolby(AudioPolicyClientInterface* client) {
+    int upmixPkg = 0;
+    if (sonyGetHalInt(client, "isUpmixSupportedPkg", &upmixPkg) && upmixPkg != 0) {
+        return true;
+    }
+    bool dseePrio = false;
+    if (sonyGetHalBool(client, "is_dsee_prioritized", &dseePrio) && dseePrio) {
+        return true;
+    }
+    int dseePrioInt = 0;
+    if (sonyGetHalInt(client, "is_dsee_prioritized", &dseePrioInt) && dseePrioInt != 0) {
+        return true;
+    }
+    return false;
+}
+
+}  // namespace
+
+bool sonyDolbyEnabled(AudioPolicyClientInterface* client) {
+    bool enabled = false;
+    if (sonyGetHalBool(client, "dle_ds_state", &enabled)) {
+        return enabled;
+    }
+    if (sonyGetHalBool(client, "dolby_dap_enable", &enabled)) {
+        return enabled;
+    }
+    int enable = 0;
+    if (sonyGetHalInt(client, "dolby_enable", &enable)) {
+        return enable != 0;
+    }
+
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.audio.dolby.enabled", value, "0");
+    if (value[0] == '\0' || value[0] == '0') {
+        return false;
+    }
+    if (strcasecmp(value, "false") == 0) {
+        return false;
+    }
+    return true;
+}
+
+bool sonyDseeHxEnabled(AudioPolicyClientInterface* client) {
+    bool enabled = false;
+    if (sonyGetHalBool(client, "dsee_hx_state", &enabled)) {
+        return enabled;
+    }
+    int state = 0;
+    if (sonyGetHalInt(client, "dsee_hx_state", &state)) {
+        return state != 0;
+    }
+    return false;
+}
+
+static bool sonyDseePrioritizedInternal(AudioPolicyClientInterface* client) {
+    return sonySonyEffectWinsOverDolby(client);
+}
+
+bool sonyDseePrioritized(AudioPolicyClientInterface* client) {
+    return sonyDseePrioritizedInternal(client);
+}
+
+bool sonyUsesDseeRouting(AudioPolicyClientInterface* client) {
+    if (sonyUses360RaEffectRouting(client)) {
+        return false;
+    }
+    if (!sonyDseeHxEnabled(client)) {
+        return false;
+    }
+    if (!sonyDolbyEnabled(client)) {
+        return true;
+    }
+  // Dolby + DSEE: same arbitration as Dolby + 360 — prioritized app routes DSEE (direct).
+    return sonySonyEffectWinsOverDolby(client);
+}
+
+bool sonyUsesDolbyRouting(AudioPolicyClientInterface* client) {
+    if (!sonyDolbyEnabled(client)) {
+        return false;
+    }
+    if (sonyDseeHxEnabled(client) && sonySonyEffectWinsOverDolby(client)) {
+        return false;
+    }
+    return true;
+}
+
+void sonyDolbyAdjustOutputFlags(AudioPolicyClientInterface* client, audio_stream_type_t stream,
+                                audio_output_flags_t* flags) {
+    if (flags == nullptr || stream != AUDIO_STREAM_MUSIC) {
+        return;
+    }
+
+    const bool dolbyOn = sonyDolbyEnabled(client);
+    const bool dseeOn = sonyDseeHxEnabled(client);
+    const bool sonyWins = sonySonyEffectWinsOverDolby(client);
+    const bool useDseeRouting = sonyUsesDseeRouting(client);
+    const bool useDolbyRouting = sonyUsesDolbyRouting(client);
+    const bool use360RaRouting = sonyUses360RaEffectRouting(client);
+    if (!useDseeRouting && !useDolbyRouting && !use360RaRouting) {
+        ALOGI("%s() dolby=%d dsee=%d no routing change flags=0x%x",
+              __func__, dolbyOn ? 1 : 0, dseeOn ? 1 : 0, *flags);
+        return;
+    }
+
+    const audio_output_flags_t before = *flags;
+    if (useDolbyRouting || use360RaRouting) {
+        // Dolby / 360 upmix: deep-buffer mixer (DAP / global upmix effects).
+        *flags = static_cast<audio_output_flags_t>(
+                *flags & ~(AUDIO_OUTPUT_FLAG_DIRECT | AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD |
+                           AUDIO_OUTPUT_FLAG_HW_AV_SYNC));
+    } else if (useDseeRouting) {
+        // DSEE: direct_pcm when Sony effect wins (or Dolby off).
+        *flags = static_cast<audio_output_flags_t>(
+                (*flags & ~(AUDIO_OUTPUT_FLAG_DEEP_BUFFER |
+                            AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD |
+                            AUDIO_OUTPUT_FLAG_HW_AV_SYNC)) |
+                AUDIO_OUTPUT_FLAG_DIRECT);
+    }
+
+    ALOGI("%s() dolby=%d dsee=%d sony_wins=%d dsee_route=%d dolby_route=%d 360ra_route=%d flags 0x%x -> 0x%x",
+          __func__, dolbyOn ? 1 : 0, dseeOn ? 1 : 0, sonyWins ? 1 : 0,
+          useDseeRouting ? 1 : 0, useDolbyRouting ? 1 : 0, use360RaRouting ? 1 : 0,
+          before, *flags);
+}
+
+bool sonyDseeBlocksOffload(AudioPolicyClientInterface* client, audio_stream_type_t stream) {
+    return stream == AUDIO_STREAM_MUSIC && sonyUsesDseeRouting(client);
+}
+
+void sonyNotifyPlayingPkgUid(AudioPolicyClientInterface* client, audio_io_handle_t io,
+                             uid_t uid) {
+    if (client == nullptr) {
+        return;
+    }
+    (void)io;
+    const std::string package = sonyPackageNameForUid(uid);
+    AudioParameter param;
+    param.addInt(String8("playing_pkg_uid"), static_cast<int>(uid));
+    if (!package.empty()) {
+        param.add(String8("playing_pkg_name"), String8(package.c_str()));
+    }
+    ALOGI("%s: uid=%u pkg=%s", __func__, uid,
+          package.empty() ? "(unknown)" : package.c_str());
+    client->setParameters(AUDIO_IO_HANDLE_NONE, param.toString());
+}
+
+bool sonyMusicOutputMatchesRouting(AudioPolicyClientInterface* client,
+                                   audio_output_flags_t outputFlags) {
+    const bool useDseeRouting = sonyUsesDseeRouting(client);
+    const bool useDolbyRouting = sonyUsesDolbyRouting(client);
+    const bool use360RaRouting = sonyUses360RaEffectRouting(client);
+
+    const bool onDirect = (outputFlags & AUDIO_OUTPUT_FLAG_DIRECT) != 0 &&
+            (outputFlags & AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD) == 0;
+    const bool onDeepBuffer = (outputFlags & AUDIO_OUTPUT_FLAG_DEEP_BUFFER) != 0;
+
+    if (useDolbyRouting || use360RaRouting) {
+        if (onDirect || (outputFlags & AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD) != 0) {
+            return false;
+        }
+        const bool onPrimary = (outputFlags & AUDIO_OUTPUT_FLAG_PRIMARY) != 0;
+        return onDeepBuffer || onPrimary;
+    }
+    if (useDseeRouting) {
+        const bool onPrimary = (outputFlags & AUDIO_OUTPUT_FLAG_PRIMARY) != 0;
+        if (onPrimary || onDeepBuffer) {
+            return false;
+        }
+        return onDirect;
+    }
+    return true;
+}
+
+} // namespace android
diff --git a/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.h b/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.h
