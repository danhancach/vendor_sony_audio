 }
 
+void AudioPolicyService::invalidateMusicStreamsForSonyRouting(bool invalidateAll) {
+    audio_utils::lock_guard _l(mMutex);
+    if (mAudioPolicyManager == nullptr) {
+        return;
+    }
+    auto* apm = static_cast<AudioPolicyManager*>(mAudioPolicyManager);
+    if (invalidateAll) {
+        apm->sonyInvalidateAllMusicTracks();
+    } else {
+        apm->sonyInvalidateMismatchedMusicTracks();
+    }
+}
