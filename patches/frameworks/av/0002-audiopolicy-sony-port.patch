index 0000000000..5244627b87
--- /dev/null
+++ b/services/audiopolicy/managerdefault/SonyDolbyAudioPolicy.h
@@ -0,0 +1,29 @@
+/*
+ * Sony Dolby / DSEE routing for STREAM_MUSIC.
+ * 360 Upmix and DSEE are peer UI toggles (mutually exclusive). Arbitration with Dolby
+ * is identical: effect-priority app lets Sony effect win; excluded app lets Dolby win.
+ * DSEE wins → DIRECT pcm; Dolby / 360 upmix → deep-buffer mixer (+ skipEffect in flinger).
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <system/audio.h>
+
+namespace android {
+
+class AudioPolicyClientInterface;
+
+bool sonyDolbyEnabled(AudioPolicyClientInterface* client);
+bool sonyDseeHxEnabled(AudioPolicyClientInterface* client);
+bool sonyDseePrioritized(AudioPolicyClientInterface* client);
+bool sonyUsesDseeRouting(AudioPolicyClientInterface* client);
+bool sonyUsesDolbyRouting(AudioPolicyClientInterface* client);
+void sonyDolbyAdjustOutputFlags(AudioPolicyClientInterface* client, audio_stream_type_t stream,
+                                audio_output_flags_t* flags);
+bool sonyDseeBlocksOffload(AudioPolicyClientInterface* client, audio_stream_type_t stream);
+void sonyNotifyPlayingPkgUid(AudioPolicyClientInterface* client, audio_io_handle_t io,
+                             uid_t uid);
+bool sonyMusicOutputMatchesRouting(AudioPolicyClientInterface* client,
+                                   audio_output_flags_t outputFlags);
+
+}  // namespace android
