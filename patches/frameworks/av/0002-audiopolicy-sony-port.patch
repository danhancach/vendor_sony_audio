index 0000000000..1a995d9a83
--- /dev/null
+++ b/services/audiopolicy/managerdefault/Sony360RAudioPolicy.cpp
@@ -0,0 +1,284 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#define LOG_TAG "Sony360RAudioPolicy"
+
+#include "Sony360RAudioPolicy.h"
+
+#include <media/AudioParameter.h>
+#include <cutils/properties.h>
+#include <binder/PermissionController.h>
+#include <fstream>
+#include <limits>
+#include <string>
+#include <utils/Log.h>
+
+#include "AudioPolicyInterface.h"
+#include "SonyDolbyAudioPolicy.h"
+
+namespace android {
+
+namespace {
+
+constexpr uint32_t kSony360RaMaskBase = 0x72f000U;
+constexpr uint32_t kSony360RaMaskMaxDelta = 0x607U;
+
+bool sonyGetHalInt(AudioPolicyClientInterface* client, const char* key, int* value) {
+    if (client == nullptr || key == nullptr || value == nullptr) {
+        return false;
+    }
+    const String8 result = client->getParameters(AUDIO_IO_HANDLE_NONE, String8(key));
+    if (result.length() == 0) {
+        return false;
+    }
+    AudioParameter param(result);
+    return param.getInt(String8(key), *value) == NO_ERROR;
+}
+
+uint32_t sonyChannelCount(audio_channel_mask_t mask) {
+    if (mask == AUDIO_CHANNEL_NONE) {
+        return 0;
+    }
+    if (audio_channel_mask_get_representation(mask) == AUDIO_CHANNEL_REPRESENTATION_INDEX) {
+        return audio_channel_count_from_out_mask(mask);
+    }
+    return audio_channel_count_from_out_mask(mask);
+}
+
+}  // namespace
+
+bool sony360RaEnabled() {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get("vendor.360ra.effect", value, "");
+    return value[0] == '1';
+}
+
+bool sony360RaUpmixModeActive(AudioPolicyClientInterface* client) {
+    if (!sony360RaEnabled()) {
+        return false;
+    }
+    int mode = 0;
+    if (!sonyGetHalInt(client, "360ra_upmix_headphone", &mode) &&
+            !sonyGetHalInt(client, "enable_360ss", &mode)) {
+        return false;
+    }
+    return mode != 0;
+}
+
+bool sony360RaContentsActive(AudioPolicyClientInterface* client) {
+    if (!sony360RaEnabled()) {
+        return false;
+    }
+    int contents = 0;
+    return sonyGetHalInt(client, "360ra_contents", &contents) && contents != 0;
+}
+
+bool sonyUses360RaEffectRouting(AudioPolicyClientInterface* client) {
+    return sony360RaUpmixModeActive(client) || sony360RaContentsActive(client);
+}
+
+void sony360RaForceMixerRoutingFlags(audio_output_flags_t* flags) {
+    if (flags == nullptr) {
+        return;
+    }
+    const audio_output_flags_t before = *flags;
+    *flags = static_cast<audio_output_flags_t>(
+            *flags & ~(AUDIO_OUTPUT_FLAG_DIRECT | AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD |
+                       AUDIO_OUTPUT_FLAG_HW_AV_SYNC | AUDIO_OUTPUT_FLAG_SPATIALIZER));
+    if ((before & AUDIO_OUTPUT_FLAG_DEEP_BUFFER) == 0 &&
+            (before & AUDIO_OUTPUT_FLAG_FAST) == 0) {
+        *flags = static_cast<audio_output_flags_t>(*flags | AUDIO_OUTPUT_FLAG_DEEP_BUFFER);
+    }
+}
+
+bool sonyIs360RaChannelMask(audio_channel_mask_t mask) {
+    if (mask == AUDIO_CHANNEL_NONE) {
+        return false;
+    }
+    const uint32_t maskValue = static_cast<uint32_t>(mask);
+    if (maskValue >= kSony360RaMaskBase &&
+        (maskValue - kSony360RaMaskBase) <= kSony360RaMaskMaxDelta) {
+        return true;
+    }
+    return sonyChannelCount(mask) >= 13;
+}
+
+std::string sonyPackageNameForUid(uid_t uid) {
+    if (uid == 0 || uid == static_cast<uid_t>(-1)) {
+        return {};
+    }
+    Vector<String16> packages;
+    PermissionController permissionController;
+    permissionController.getPackagesForUid(uid, packages);
+    if (!packages.isEmpty()) {
+        return String8(packages[0]).c_str();
+    }
+    std::ifstream packagesFile("/data/system/packages.list");
+    if (!packagesFile.is_open()) {
+        return {};
+    }
+    std::string package;
+    uid_t pkgUid = static_cast<uid_t>(-1);
+    while (packagesFile >> package >> pkgUid) {
+        if (pkgUid == uid) {
+            return package;
+        }
+        packagesFile.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
+    }
+    return {};
+}
+
+bool sonyIsUpmixApplicable(AudioPolicyClientInterface* client) {
+    if (!sony360RaEnabled()) {
+        return false;
+    }
+    int applicable = 0;
+    if (!sonyGetHalInt(client, "360ra_upmix_applicable", &applicable)) {
+        return true;
+    }
+    return applicable != 0;
+}
+
+bool sonyCheckUpmixIsApplicable(AudioPolicyClientInterface* client, audio_stream_type_t stream,
+                                const audio_config_t* config, audio_output_flags_t flags) {
+    if (!sony360RaEnabled() || config == nullptr) {
+        return false;
+    }
+    if (sonyIs360RaChannelMask(config->channel_mask)) {
+        if (stream != AUDIO_STREAM_MUSIC) {
+            ALOGV("%s: false due to non music 360RA channel mask", __func__);
+            return false;
+        }
+        if (!audio_is_linear_pcm(config->format)) {
+            ALOGV("%s: false due to non linear pcm", __func__);
+            return false;
+        }
+        if ((flags & (AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD | AUDIO_OUTPUT_FLAG_HW_AV_SYNC)) != 0) {
+            ALOGV("%s: false due to unsupported flags 0x%x", __func__, flags);
+            return false;
+        }
+        ALOGV("%s: 360RA channel mask applicable", __func__);
+        return sonyIsUpmixApplicable(client);
+    }
+    if ((flags & AUDIO_OUTPUT_FLAG_DIRECT) != 0) {
+        ALOGV("%s: DIRECT output, upmix path allowed", __func__);
+        return true;
+    }
+    if (!audio_is_linear_pcm(config->format)) {
+        ALOGV("%s: false due to non linear pcm", __func__);
+        return false;
+    }
+    if (stream != AUDIO_STREAM_MUSIC && config->channel_mask != AUDIO_CHANNEL_OUT_MONO) {
+        ALOGV("%s: false due to non music or invalid channel", __func__);
+        return false;
+    }
+    if (sonyChannelCount(config->channel_mask) < 3) {
+        ALOGV("%s: false due to non music or invalid channel", __func__);
+        return false;
+    }
+    if ((flags & (AUDIO_OUTPUT_FLAG_FAST | AUDIO_OUTPUT_FLAG_DEEP_BUFFER)) == 0) {
+        ALOGV("%s: false due to unsupported flags 0x%x", __func__, flags);
+        return false;
+    }
+    if ((flags & AUDIO_OUTPUT_FLAG_DEEP_BUFFER) != 0) {
+        ALOGV("%s: DEEP_BUFFER is OK", __func__);
+    }
+    return sonyIsUpmixApplicable(client);
+}
+
+void sony360RaAdjustOutputFlags(AudioPolicyClientInterface* client, audio_stream_type_t stream,
+                                const audio_config_t* config, audio_output_flags_t* flags) {
+    if (flags == nullptr || config == nullptr || stream != AUDIO_STREAM_MUSIC) {
+        return;
+    }
+    // DSEE and 360 upmix are mutually exclusive; DSEE routing uses direct_pcm.
+    if (sonyUsesDseeRouting(client)) {
+        return;
+    }
+    // Native 360RA (mhm1/mha1, 13ch): stock routes via deep-buffer mixer, not AOSP spatializer.
+    if (sony360RaEnabled() && sonyIs360RaChannelMask(config->channel_mask)) {
+        const audio_output_flags_t before = *flags;
+        sony360RaForceMixerRoutingFlags(flags);
+        ALOGI("%s: native 360RA mask 0x%x, flags 0x%x -> 0x%x", __func__,
+              config->channel_mask, before, *flags);
+        return;
+    }
+    // Stereo upmix runs through global session-0 effects on the deep-buffer mixer path.
+    if (sony360RaUpmixModeActive(client) && sonyChannelCount(config->channel_mask) <= 2) {
+        const audio_output_flags_t before = *flags;
+        sony360RaForceMixerRoutingFlags(flags);
+        ALOGI("%s: 360RA upmix mode active, stereo flags 0x%x -> 0x%x", __func__, before, *flags);
+        return;
+    }
+    if (!sonyCheckUpmixIsApplicable(client, stream, config, *flags)) {
+        return;
+    }
+    const audio_output_flags_t before = *flags;
+    *flags = static_cast<audio_output_flags_t>(
+            *flags & ~(AUDIO_OUTPUT_FLAG_DIRECT | AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD |
+                       AUDIO_OUTPUT_FLAG_HW_AV_SYNC | AUDIO_OUTPUT_FLAG_SPATIALIZER));
+    if ((before & AUDIO_OUTPUT_FLAG_DEEP_BUFFER) == 0) {
+        *flags = static_cast<audio_output_flags_t>(*flags | AUDIO_OUTPUT_FLAG_DEEP_BUFFER);
+    }
+    ALOGI("%s: 360RA upmix applicable flags 0x%x -> 0x%x", __func__, before, *flags);
+}
+
+void sonySet360RaContents(AudioPolicyClientInterface* client, bool active) {
+    if (client == nullptr || !sony360RaEnabled()) {
+        return;
+    }
+    AudioParameter param;
+    param.addInt(String8("360ra_contents"), active ? 1 : 0);
+    ALOGI("%s: 360ra_contents=%d", __func__, active ? 1 : 0);
+    client->setParameters(AUDIO_IO_HANDLE_NONE, param.toString());
+}
+
+void sonyUpdate360RaContentsForConfig(AudioPolicyClientInterface* client,
+                                      audio_stream_type_t stream, const audio_config_t* config) {
+    if (config == nullptr) {
+        return;
+    }
+    if (stream != AUDIO_STREAM_MUSIC && config->channel_mask != AUDIO_CHANNEL_OUT_MONO) {
+        return;
+    }
+    sonySet360RaContents(client, sonyIs360RaChannelMask(config->channel_mask));
+}
+
+void sonyUpdate360RaContentsForClient(AudioPolicyClientInterface* client,
+                                      audio_stream_type_t stream,
+                                      audio_channel_mask_t channelMask, bool starting) {
+    if (client == nullptr) {
+        return;
+    }
+    if (stream != AUDIO_STREAM_MUSIC) {
+        if (!starting) {
+            sonySet360RaContents(client, false);
+        }
+        return;
+    }
+    if (starting) {
+        sonySet360RaContents(client, sonyIs360RaChannelMask(channelMask));
+        return;
+    }
+    if (sonyIs360RaChannelMask(channelMask)) {
+        sonySet360RaContents(client, false);
+    }
+}
+
+void sonyNotifyUpmixPlayingPkg(AudioPolicyClientInterface* client, audio_io_handle_t io, uid_t uid) {
+    if (client == nullptr) {
+        return;
+    }
+    (void)io;
+    const std::string package = sonyPackageNameForUid(uid);
+    AudioParameter param;
+    if (!package.empty()) {
+        param.add(String8("chk_upmix_playing_pkg_name"), String8(package.c_str()));
+    }
+    param.addInt(String8("chk_upmix_playing_pkg_uid"), static_cast<int>(uid));
+    ALOGI("%s: uid=%u pkg=%s", __func__, uid,
+          package.empty() ? "(unknown)" : package.c_str());
+    client->setParameters(AUDIO_IO_HANDLE_NONE, param.toString());
+}
+
+}  // namespace android
