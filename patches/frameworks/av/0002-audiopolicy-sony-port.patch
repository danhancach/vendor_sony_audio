+
+void AudioPolicyManager::sonyInvalidateMismatchedMusicTracks() {
+    const bool dolbyOn = sonyDolbyEnabled(mpClientInterface);
+    const bool dseeOn = sonyDseeHxEnabled(mpClientInterface);
+    PortHandleVector clientsToInvalidate;
+    for (size_t i = 0; i < mOutputs.size(); i++) {
+        const sp<SwAudioOutputDescriptor>& outputDesc = mOutputs[i];
+        if (sonyMusicOutputMatchesRouting(mpClientInterface, outputDesc->mFlags)) {
+            continue;
+        }
+        for (const sp<TrackClientDescriptor>& client : outputDesc->getClientIterable()) {
+            if (client->stream() == AUDIO_STREAM_MUSIC && client->active()) {
+                clientsToInvalidate.push_back(client->portId());
+            }
+        }
+    }
+    if (clientsToInvalidate.empty()) {
+        return;
+    }
+    ALOGI("%s: invalidating %zu music track(s) dolby=%d dsee=%d routing mismatch",
+          __func__, clientsToInvalidate.size(), dolbyOn ? 1 : 0, dseeOn ? 1 : 0);
+    mpClientInterface->invalidateTracks(clientsToInvalidate);
+}
