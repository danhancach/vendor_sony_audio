+#include <system/audio.h>
+
+namespace android {
+
+class AudioPolicyClientInterface;
+
+bool sony360RaEnabled();
+bool sony360RaUpmixModeActive(AudioPolicyClientInterface* client);
+bool sonyUses360RaEffectRouting(AudioPolicyClientInterface* client);
+void sony360RaForceMixerRoutingFlags(audio_output_flags_t* flags);
+bool sonyIs360RaChannelMask(audio_channel_mask_t mask);
+bool sonyIsUpmixApplicable(AudioPolicyClientInterface* client);
+bool sonyCheckUpmixIsApplicable(AudioPolicyClientInterface* client, audio_stream_type_t stream,
+                                const audio_config_t* config, audio_output_flags_t flags);
