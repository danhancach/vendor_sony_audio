diff --git a/services/audioflinger/EffectDapController.cpp b/services/audioflinger/EffectDapController.cpp
new file mode 100644
index 0000000000..16b882a9d7
--- /dev/null
+++ b/services/audioflinger/EffectDapController.cpp
@@ -0,0 +1,224 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#define LOG_TAG "EffectDapController"
+
+#include "EffectDapController.h"
+
+#include <cutils/properties.h>
+#include <media/AudioEffect.h>
+#include <strings.h>
+#include <sys/system_properties.h>
+#include <unistd.h>
+#include <utils/Log.h>
+#include <utils/Timers.h>
+
+#include "ds_config.h"
+
+namespace android {
+
+namespace {
+
+constexpr const char* kDolbyEnabledProp = "persist.audio.dolby.enabled";
+
+void* dolbyPropertyWatchEntry(void* /*arg*/) {
+    uint32_t serial = 0;
+    const prop_info* pi = nullptr;
+    while (EffectDapController::instance() != nullptr &&
+            EffectDapController::instance()->propertyWatcherRunning()) {
+        if (pi == nullptr) {
+            pi = __system_property_find(kDolbyEnabledProp);
+            if (pi == nullptr) {
+                usleep(500000);
+                continue;
+            }
+        }
+        uint32_t newSerial = serial;
+        const timespec timeout = {1, 0};
+        if (__system_property_wait(pi, serial, &newSerial, &timeout)) {
+            serial = newSerial;
+            if (EffectDapController* ctrl = EffectDapController::instance()) {
+                ctrl->updateBypassFromProperty();
+            }
+        }
+    }
+    return nullptr;
+}
+
+} // namespace
+
+EffectDapController* EffectDapController::sInstance = nullptr;
+
+EffectDapController* EffectDapController::instance() {
+    return sInstance;
+}
+
+void EffectDapController::create(AudioFlinger* audioFlinger) {
+    if (sInstance == nullptr) {
+        sInstance = new EffectDapController(audioFlinger);
+        sInstance->startPropertyWatcher();
+    }
+}
+
+void EffectDapController::destroy() {
+    if (sInstance != nullptr) {
+        sInstance->stopPropertyWatcher();
+    }
+    delete sInstance;
+    sInstance = nullptr;
+}
+
+EffectDapController::EffectDapController(AudioFlinger* /* audioFlinger */) {}
+
+void EffectDapController::startPropertyWatcher() {
+    if (mPropWatchRunning.exchange(true)) {
+        return;
+    }
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    pthread_create(&mPropWatchThread, &attr, dolbyPropertyWatchEntry, nullptr);
+    pthread_attr_destroy(&attr);
+}
+
+void EffectDapController::stopPropertyWatcher() {
+    mPropWatchRunning.store(false);
+}
+
+bool EffectDapController::propertyWatcherRunning() const {
+    return mPropWatchRunning.load();
+}
+
+static bool parseDolbyEnabledProp(const char* value) {
+    if (value == nullptr || value[0] == '\0' || value[0] == '0') {
+        return false;
+    }
+    if (strcasecmp(value, "false") == 0) {
+        return false;
+    }
+    return true;
+}
+
+bool EffectDapController::isDapEffect(const sp<IAfEffectBase>& effect) {
+    if (effect == nullptr) {
+        return false;
+    }
+    static const effect_uuid_t kDapType = {
+        0x46d279d9, 0x9be7, 0x453d, 0x9d7c, {0xef, 0x93, 0x7f, 0x67, 0x55, 0x87}};
+    static const effect_uuid_t kDapSwUuid = {
+        0x9d4921da, 0x8225, 0x4f29, 0xaefa, {0x39, 0x53, 0x7a, 0x04, 0xbc, 0xaa}};
+    const effect_uuid_t& type = effect->desc().type;
+    const effect_uuid_t& uuid = effect->desc().uuid;
+    return memcmp(&type, &kDapType, sizeof(effect_uuid_t)) == 0
+            || memcmp(&type, &kDapSwUuid, sizeof(effect_uuid_t)) == 0
+            || memcmp(&uuid, &kDapSwUuid, sizeof(effect_uuid_t)) == 0;
+}
+
+void EffectDapController::effectCreated(const sp<IAfEffectModule>& effect,
+                                        const sp<IAfThreadBase>& /* thread */) {
+    if (!isDapEffect(effect)) {
+        return;
+    }
+    Mutex::Autolock _l(mLock);
+    const bool isNew = (mDapEffect != effect);
+    mDapEffect = effect;
+    ALOGI("%s() DAP effect %s %p", __func__, isNew ? "created" : "reattached", effect.get());
+    if (isNew) {
+        mBypassed = true;
+    }
+    updateBypassFromProperty_l();
+}
+
+void EffectDapController::effectReleased(const sp<IAfEffectModule>& effect) {
+    if (!isDapEffect(effect)) {
+        return;
+    }
+    Mutex::Autolock _l(mLock);
+    if (mDapEffect == effect) {
+        mDapEffect.clear();
+        mBypassed = true;
+    }
+    ALOGD("%s() DAP effect released %p", __func__, effect.get());
+}
+
+void EffectDapController::effectSuspended(const sp<IAfEffectBase>& effect, bool suspended) {
+    if (!isDapEffect(effect)) {
+        return;
+    }
+    ALOGD("%s() DAP effect suspended=%d", __func__, suspended);
+    if (!suspended) {
+        Mutex::Autolock _l(mLock);
+        updateBypassFromProperty_l();
+    }
+}
+
+void EffectDapController::updateBypassFromProperty() {
+    Mutex::Autolock _l(mLock);
+    updateBypassFromProperty_l();
+}
+
+void EffectDapController::updateBypassFromProperty_l() {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get(kDolbyEnabledProp, value, "1");
+    const bool dolbyOn = parseDolbyEnabledProp(value);
+    const bool bypass = !dolbyOn;
+    const bool changed = mBypassed != bypass;
+    mBypassed = bypass;
+    if (changed) {
+        ALOGI("%s() dolby_enable=%d bypass=%d skip=%d", __func__, dolbyOn, bypass, bypass);
+    }
+    if (mDapEffect != nullptr) {
+        setBypass_l(bypass);
+        updateSkipEffectProcess(bypass);
+    }
+}
+
+status_t EffectDapController::setBypass_l(bool bypass) {
+    sp<IAfEffectModule> effect = mDapEffect;
+    if (effect == nullptr) {
+        return NO_INIT;
+    }
+    const int32_t bypassVal = bypass ? 1 : 0;
+    uint8_t buf[sizeof(effect_param_t) + sizeof(int32_t) + sizeof(int32_t)] = {};
+    effect_param_t* p = reinterpret_cast<effect_param_t*>(buf);
+    p->psize = sizeof(int32_t);
+    p->vsize = sizeof(int32_t);
+    const int32_t bypassParam = EFFECT_PARAM_SET_BYPASS;
+    memcpy(p->data, &bypassParam, sizeof(int32_t));
+    memcpy(p->data + sizeof(int32_t), &bypassVal, sizeof(int32_t));
+    std::vector<uint8_t> cmd(buf, buf + sizeof(buf));
+    std::vector<uint8_t> reply;
+    status_t status = effect->command(EFFECT_CMD_SET_PARAM, cmd, sizeof(buf), &reply);
+    if (status != NO_ERROR) {
+        ALOGW("%s() SET_BYPASS failed: %d", __func__, status);
+    }
+
+    if (!bypass) {
+        const int32_t skipVal = 1;
+        uint8_t buf2[sizeof(effect_param_t) + sizeof(int32_t) + sizeof(int32_t)] = {};
+        effect_param_t* p2 = reinterpret_cast<effect_param_t*>(buf2);
+        p2->psize = sizeof(int32_t);
+        p2->vsize = sizeof(int32_t);
+        const int32_t skipHardBypassParam = EFFECT_PARAM_SKIP_HARD_BYPASS;
+        memcpy(p2->data, &skipHardBypassParam, sizeof(int32_t));
+        memcpy(p2->data + sizeof(int32_t), &skipVal, sizeof(int32_t));
+        std::vector<uint8_t> cmd2(buf2, buf2 + sizeof(buf2));
+        std::vector<uint8_t> reply2;
+        status = effect->command(EFFECT_CMD_SET_PARAM, cmd2, sizeof(buf2), &reply2);
+        if (status != NO_ERROR) {
+            ALOGW("%s() SKIP_HARD_BYPASS failed: %d", __func__, status);
+        }
+    }
+    return status;
+}
+
+void EffectDapController::updateSkipEffectProcess(bool skip) {
+    sp<IAfEffectModule> effect = mDapEffect;
+    if (effect == nullptr) {
+        return;
+    }
+    effect->setSkipEffectProcess(skip);
+    ALOGD("%s() skipEffectProcess=%s", __func__, skip ? "skip" : "not skip");
+}
+
+} // namespace android
