+ * Dolby DAP effect parameter IDs (vendor/libswdap / daxService).
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <stdint.h>
+
+#define EFFECT_PARAM_SET_BYPASS           0x00010005
+#define EFFECT_PARAM_SKIP_HARD_BYPASS     0x0001000a
