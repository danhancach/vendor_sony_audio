@@ -0,0 +1,54 @@
+/*
+ * Sony / Motorola Dolby DAP coordination for AudioFlinger (pdx237 EvoX).
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <utils/Mutex.h>
+
+#include <atomic>
+#include <pthread.h>
+
+#include "IAfEffect.h"
+#include "IAfThread.h"
+
+namespace android {
+
+class AudioFlinger;
+
+class EffectDapController {
+public:
+    static EffectDapController* instance();
+    static void create(AudioFlinger* audioFlinger);
+    static void destroy();
+
+    void effectCreated(const sp<IAfEffectModule>& effect, const sp<IAfThreadBase>& thread);
+    void effectReleased(const sp<IAfEffectModule>& effect);
+    void effectSuspended(const sp<IAfEffectBase>& effect, bool suspended);
+
+    void updateBypassFromProperty();
+
+    void updateBypassFromProperty_l();
+
+    void startPropertyWatcher();
+    void stopPropertyWatcher();
+    bool propertyWatcherRunning() const;
+
+private:
+    explicit EffectDapController(AudioFlinger* audioFlinger);
+
+    static bool isDapEffect(const sp<IAfEffectBase>& effect);
+    status_t setBypass_l(bool bypass);
+    void updateSkipEffectProcess(bool skip);
+
+    static EffectDapController* sInstance;
+
+    sp<IAfEffectModule> mDapEffect;
+    Mutex mLock;
+    bool mBypassed = true;
+
+    std::atomic<bool> mPropWatchRunning{false};
+    pthread_t mPropWatchThread{};
+};
+
+} // namespace android
