diff --git a/services/audioflinger/dolby_debug.h b/services/audioflinger/dolby_debug.h
new file mode 100644
index 0000000000..5c5920c70e
--- /dev/null
+++ b/services/audioflinger/dolby_debug.h
@@ -0,0 +1,18 @@
+/*
+ * Shared Dolby debug helpers. Writes extra logs when
+ * persist.audio.dolby.debug=1 (audio_prop; audioserver can read it).
+ * persist.vendor.dolby.debug is vendor_default_prop and is denied to audioserver.
+ */
+#pragma once
+
+#include <cutils/properties.h>
+
+namespace android {
+
+static inline bool dolbyDebugEnabled() {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.audio.dolby.debug", value, "0");
+    return value[0] == '1' || value[0] == 't' || value[0] == 'T';
+}
+
+} // namespace android
