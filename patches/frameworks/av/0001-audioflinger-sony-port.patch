+void restartGlobalDapEffectForPregain(const sp<IAfEffectModule>& effect,
+                                      const sp<IAfEffectChain>& mixChain,
+                                      const sp<IAfPlaybackThread>& hostThread) {
+    if (effect == nullptr || mixChain == nullptr || hostThread == nullptr) {
+        return;
+    }
+    // Read thread state while caller holds PlaybackThread::mutex().
+    const AudioDeviceTypeAddrVector devices = hostThread->outDeviceTypeAddrs();
+    const audio_io_handle_t io = hostThread->id();
+
+    EffectModule* module = static_cast<EffectModule*>(effect.get());
+    audio_utils::lock_guard chainLock(mixChain->mutex());
+    // Stock: DISABLE → OFFLOAD(track io) → SET_CONFIG → SET_DEVICE → SET_CONFIG → ENABLE.
+    // DAP descriptor lacks EFFECT_FLAG_OFFLOAD_SUPPORTED so setOffloaded_l() skips OFFLOAD;
+    // vendor libswdap needs OFFLOAD to bind global DAP for PregainSynchronizer.
+    module->stop_l();
+    module->sendOffloadForPregain_l(io);
+    module->configure_l();
+    module->setDevices(devices);
+    module->configure_l();
+    module->start_l();
+    ALOGV("%s() DAP preg prep on track io=%d", __func__, io);
+}
