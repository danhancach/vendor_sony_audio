+            trackThread != nullptr ? trackThread : asIAfPlaybackThread();
+    if (dap == nullptr || mixChain == nullptr || ioThread == nullptr) {
+        ALOGW("%s() skip mix io=%d track io=%d dap=%p mixChain=%p", __func__, id(),
+                ioThread != nullptr ? ioThread->id() : -1, dap.get(), mixChain.get());
