+bool isSonyEffectRoutingParameter(const char* keyValuePairs) {
+    if (keyValuePairs == nullptr) {
+        return false;
+    }
+    return strstr(keyValuePairs, "dsee_hx_state") != nullptr
+            || strstr(keyValuePairs, "dle_ds_state") != nullptr
+            || strstr(keyValuePairs, "dolby_dap_enable") != nullptr
+            || strstr(keyValuePairs, "dolby_enable") != nullptr
+            || strstr(keyValuePairs, "is_dsee_prioritized") != nullptr
+            || strstr(keyValuePairs, "360ra_contents") != nullptr;
+}
+
+bool sonyNeedsFullMusicInvalidate(const char* keyValuePairs) {
+    if (keyValuePairs == nullptr) {
+        return false;
+    }
+    // Stock: invalidate when DSEE routing (DIRECT vs mixer) may change — not on Dolby ON/OFF.
+    return strstr(keyValuePairs, "dsee_hx_state") != nullptr;
+}
+
+bool sonyShouldScheduleMusicInvalidate(const char* keyValuePairs) {
+    if (keyValuePairs == nullptr) {
+        return false;
+    }
+    return strstr(keyValuePairs, "dsee_hx_state") != nullptr
+            || strstr(keyValuePairs, "is_dsee_prioritized") != nullptr;
+}
+
+int sonyInvalidateSleepBeforeUs(const char* keyValuePairs) {
+    if (keyValuePairs == nullptr) {
+        return property_get_int32("vendor.audio.invalidate_sleep_before", 100000);
+    }
+    if (strstr(keyValuePairs, "dsee_hx_state=1") != nullptr) {
+        return property_get_int32("vendor.audio.invalidate_sleep_dsee_on", 50000);
+    }
+    return property_get_int32("vendor.audio.invalidate_sleep_before", 100000);
+}
+
+// daxService sets dle_ds_state on HAL; mirror into EffectDapController (cannot rely on
+// persist.audio.dolby.enabled — SELinux denies set on this device).
+void sonyApplyDolbyHalState(const char* keyValuePairs) {
+    if (keyValuePairs == nullptr) {
+        return;
+    }
+    AudioParameter param = AudioParameter(String8(keyValuePairs));
+    String8 str;
+    int value = 0;
+    bool found = false;
+    bool dolbyOn = false;
+    if (param.get(String8("dle_ds_state"), str) == NO_ERROR) {
+        dolbyOn = str == "true" || str == "1";
+        found = true;
+    } else if (param.getInt(String8("dle_ds_state"), value) == NO_ERROR) {
+        dolbyOn = value != 0;
+        found = true;
+    }
+    if (!found) {
+        return;
+    }
+    if (EffectDapController::instance() != nullptr) {
+        EffectDapController::instance()->updateBypassFromDolbyHalState(dolbyOn);
+    }
+}
+
+void sonyApplyDseeHalState(const char* keyValuePairs) {
+    if (keyValuePairs == nullptr) {
+        return;
+    }
+    AudioParameter param = AudioParameter(String8(keyValuePairs));
+    String8 str;
+    int value = 0;
+    bool found = false;
+    bool dseeOn = false;
+    if (param.get(String8("dsee_hx_state"), str) == NO_ERROR) {
+        dseeOn = str == "true" || str == "1";
+        found = true;
+    } else if (param.getInt(String8("dsee_hx_state"), value) == NO_ERROR) {
+        dseeOn = value != 0;
+        found = true;
+    }
+    if (!found) {
+        return;
+    }
+    if (EffectDapController::instance() != nullptr) {
+        EffectDapController::instance()->updateBypassFromDseeHalState(dseeOn);
+    }
+}
