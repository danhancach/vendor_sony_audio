+bool EffectDapController::isMusicListenerEffect(const sp<IAfEffectBase>& effect) {
+    return isDlbVolumeListenerEffect(effect);
+}
+
+bool EffectDapController::isDlbVolumeListenerEffect(const sp<IAfEffectBase>& effect) {
+    if (effect == nullptr) {
+        return false;
+    }
+    static const effect_uuid_t kMusicListenerUuid = {
+        0x40f66c8b, 0x5aa5, 0x4345, 0x8919,
+        {0x53, 0xec, 0x43, 0x1a, 0xaa, 0x98}};
+    static const effect_uuid_t kAlarmListenerUuid = {
+        0x6aff229c, 0x30c6, 0x4cc8, 0x9957,
+        {0xdb, 0xfe, 0x5c, 0x1b, 0xd7, 0xf6}};
+    static const effect_uuid_t kNotificationListenerUuid = {
+        0x1f0091e3, 0x6ad8, 0x40fe, 0x9b09,
+        {0x59, 0x48, 0xf9, 0xa2, 0x6e, 0x7e}};
+    const effect_uuid_t& uuid = effect->desc().uuid;
+    return memcmp(&uuid, &kMusicListenerUuid, sizeof(effect_uuid_t)) == 0
+            || memcmp(&uuid, &kAlarmListenerUuid, sizeof(effect_uuid_t)) == 0
+            || memcmp(&uuid, &kNotificationListenerUuid, sizeof(effect_uuid_t)) == 0;
+}
+
+bool EffectDapController::requestPregainPrep() {
+    const nsecs_t now = systemTime();
+    Mutex::Autolock _l(mLock);
+    if (mLastPregPrepNs != 0 && (now - mLastPregPrepNs) < kPregPrepMinIntervalNs) {
+        return false;
+    }
+    mLastPregPrepNs = now;
+    return true;
+}
+
+sp<IAfEffectModule> EffectDapController::globalDapEffect() {
+    Mutex::Autolock _l(mLock);
+    return mDapEffect;
+}
+
+void EffectDapController::executePregainPrep_l(const sp<IAfPlaybackThread>& mlThread) {
+    sp<IAfPlaybackThread> dapThread = mDapPlaybackThread.promote();
+    if (dapThread == nullptr || mDapEffect == nullptr) {
+        return;
+    }
+    mPendingDapPregPrep = dapThread;
+    if (mlThread != nullptr) {
+        mPendingMlForResync = mlThread;
+    }
+    ALOGV("%s() scheduled on mix io=%d", __func__, dapThread->id());
+}
+
+void EffectDapController::runPregainPrepSync(const sp<IAfPlaybackThread>& mlThread,
+        const sp<IAfPlaybackThread>& dapThread) {
+    dapThread->prepareDapPregainForTrackThread(mlThread);
+    if (mlThread != nullptr) {
+        mlThread->prepareDapPregainResyncVolumes();
+        ALOGI("%s() mix io=%d track io=%d", __func__, dapThread->id(), mlThread->id());
+    }
+}
+
+void EffectDapController::onDapPregPrepComplete_l() {
+    sp<IAfPlaybackThread> mlThread = mPendingMlForResync.promote();
+    if (mlThread == nullptr) {
+        return;
+    }
+    mPendingMlVolumeResync = mlThread;
+    mPendingMlForResync.clear();
+}
+
+bool EffectDapController::runPendingDapPregainOnMixThread(
+        const sp<IAfPlaybackThread>& mixThread) {
+    sp<IAfPlaybackThread> trackThread;
+    {
+        Mutex::Autolock _l(mLock);
+        if (!consumePendingDapPregPrep_l(mixThread)) {
+            return false;
+        }
+        trackThread = mPendingMlForResync.promote();
+    }
+    mixThread->prepareDapPregainForTrackThread(trackThread);
+    Mutex::Autolock _l(mLock);
+    onDapPregPrepComplete_l();
+    return true;
+}
+
+void EffectDapController::preparePregainForMusicListener(
+        const sp<IAfPlaybackThread>& mlThread) {
+    if (mlThread == nullptr) {
+        return;
+    }
+    sp<IAfPlaybackThread> dapThread;
+    {
+        Mutex::Autolock _l(mLock);
+        dapThread = mDapPlaybackThread.promote();
+        if (dapThread == nullptr || mDapEffect == nullptr) {
+            mPendingMlPregPrep = mlThread;
+            ALOGI("%s() deferred until global DAP bound", __func__);
+            return;
+        }
+    }
+    if (!requestPregainPrep()) {
+        return;
+    }
+    runPregainPrepSync(mlThread, dapThread);
+}
+
+void EffectDapController::runDeferredPregainPrep() {
+    sp<IAfPlaybackThread> mlThread;
+    {
+        Mutex::Autolock _l(mLock);
+        mlThread = mPendingMlPregPrep.promote();
+        if (mlThread == nullptr || mDapEffect == nullptr ||
+                mDapPlaybackThread.promote() == nullptr) {
+            return;
+        }
+        mPendingMlPregPrep.clear();
+    }
+    if (!requestPregainPrep()) {
+        return;
+    }
+    ALOGV("%s() running deferred ML preg prep", __func__);
+    Mutex::Autolock _l(mLock);
+    executePregainPrep_l(mlThread);
+}
+
+void EffectDapController::onGlobalMixChainAttached(
+        const sp<IAfPlaybackThread>& thread,
+        const sp<IAfEffectChain>& chain) {
+    if (thread == nullptr || chain == nullptr) {
+        return;
+    }
+    const sp<IAfThreadBase> threadBase = thread;
+    {
+        Mutex::Autolock _l(mLock);
+        mDapPlaybackThread = thread;
+        for (size_t i = 0; i < chain->numberOfEffects(); ++i) {
+            const sp<IAfEffectModule> effect = chain->getEffectModule(i);
+            if (isDapEffect(effect)) {
+                mDapEffect = effect;
+                ALOGI("%s() global DAP bound to playback thread", __func__);
+                break;
+            }
+        }
+    }
+    connectDmsIfNeeded(threadBase);
+    runDeferredPregainPrep();
+}
+
+void EffectDapController::finishDapRestartOnHostThread() {
+    Mutex::Autolock _l(mLock);
+    finishDapRestartForPregain_l();
+}
+
+void EffectDapController::finishDapRestartForPregain_l() {
+    if (mDapEffect == nullptr) {
+        return;
+    }
+    status_t status = sendEffectIntParam(mDapEffect, EFFECT_PARAM_SKIP_HARD_BYPASS, 1);
+    if (status != NO_ERROR) {
+        ALOGW("%s() SKIP_HARD_BYPASS failed: %d", __func__, status);
+    }
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get(kDolbyEnabledProp, value, "0");
+    const bool dolbyOn = mDolbyHalOn || parseDolbyEnabledProp(value);
+    if (dolbyOn) {
+        setBypass_l(false);
+    }
+}
+
+bool EffectDapController::consumePendingMlVolumeResync(
+        const sp<IAfPlaybackThread>& thread) {
+    sp<IAfPlaybackThread> pending;
+    {
+        Mutex::Autolock _l(mLock);
+        pending = mPendingMlVolumeResync.promote();
+        if (pending == nullptr || pending.get() != thread.get()) {
+            return false;
+        }
+        mPendingMlVolumeResync.clear();
+    }
+    ALOGV("%s() ML volume resync on mixer frame", __func__);
+    return true;
+}
+
+bool EffectDapController::consumePendingDapPregPrep_l(
+        const sp<IAfPlaybackThread>& thread) {
+    sp<IAfPlaybackThread> pending = mPendingDapPregPrep.promote();
+    if (pending == nullptr || pending.get() != thread.get()) {
+        return false;
+    }
+    mPendingDapPregPrep.clear();
+    return true;
+}
+
+void EffectDapController::effectCreated(const sp<IAfEffectModule>& effect,
+                                        const sp<IAfThreadBase>& thread) {
+    if (isMusicListenerEffect(effect)) {
+        ALOGI("%s() Music Listener attached session %d", __func__, effect->sessionId());
+        return;
+    }
+    if (isUpmixEffect(effect)) {
+        Mutex::Autolock _l(mLock);
+        mUpmixEffect = effect;
+        updateEffectPriority_l();
+        ALOGI("%s() 360 Upmix attached session %d mode=%d", __func__, effect->sessionId(),
+              mUpmixHeadphoneMode);
+        return;
+    }
+    if (!isDapEffect(effect)) {
+        return;
+    }
+    bool isNew = false;
+    {
+        Mutex::Autolock _l(mLock);
+        isNew = (mDapEffect != effect);
+        mDapEffect = effect;
+        if (isNew) {
+            mBypassed = true;
+        }
+        if (thread != nullptr && effect->sessionId() == AUDIO_SESSION_OUTPUT_MIX) {
+            mDapPlaybackThread = thread->asIAfPlaybackThread();
+        }
+    }
+    ALOGI("%s() DAP effect %s %p session=%d", __func__, isNew ? "created" : "reattached",
+            effect.get(), effect->sessionId());
+    connectDmsIfNeeded(thread);
+    const bool isGlobalDap = effect->sessionId() == AUDIO_SESSION_OUTPUT_MIX;
+    {
+        Mutex::Autolock _l(mLock);
+        updateBypassFromProperty_l();
+    }
+    if (isGlobalDap) {
+        runDeferredPregainPrep();
+    }
+}
+
+void EffectDapController::effectReleased(const sp<IAfEffectModule>& effect) {
+    if (isUpmixEffect(effect)) {
+        Mutex::Autolock _l(mLock);
+        if (mUpmixEffect == effect) {
+            mUpmixEffect.clear();
+        }
+        ALOGD("%s() 360 Upmix released %p", __func__, effect.get());
+        return;
+    }
+    if (!isDapEffect(effect)) {
+        return;
+    }
+    Mutex::Autolock _l(mLock);
+    if (mDapEffect == effect) {
+        mDapEffect.clear();
+        mDapPlaybackThread.clear();
+        mBypassed = true;
+        if (mDmsClient != nullptr) {
+            mDmsClient->disconnect();
+        }
+    }
+    ALOGD("%s() DAP effect released %p", __func__, effect.get());
+}
+
+void EffectDapController::effectSuspended(const sp<IAfEffectBase>& effect, bool suspended) {
+    if (!isDapEffect(effect)) {
+        return;
+    }
+    ALOGD("%s() DAP effect suspended=%d", __func__, suspended);
+    if (!suspended) {
+        Mutex::Autolock _l(mLock);
+        if (!mBypassed) {
+            setBypass_l(false);
+        }
+    }
+}
+
+void EffectDapController::updateBypassFromProperty() {
+    {
+        Mutex::Autolock _l(mLock);
+        updateBypassFromProperty_l();
+    }
+    runAfterRoutingUpdate();
+}
+
+void EffectDapController::updateBypassFromDolbyHalState(bool dolbyOn) {
+    {
+        Mutex::Autolock _l(mLock);
+        const bool halChanged = (mDolbyHalOn != dolbyOn);
+        mDolbyHalOn = dolbyOn;
+        if (halChanged) {
+            ALOGI("%s() hal dolby=%d", __func__, dolbyOn ? 1 : 0);
+        }
+        updateBypassFromProperty_l();
+    }
+    runAfterRoutingUpdate();
+}
+
+void EffectDapController::updateBypassFromDseeHalState(bool dseeOn) {
+    bool finishDap = false;
+    {
+        Mutex::Autolock _l(mLock);
+        const bool halChanged = (mDseeHalOn != dseeOn);
+        mDseeHalOn = dseeOn;
+        if (halChanged) {
+            ALOGI("%s() hal dsee=%d", __func__, dseeOn ? 1 : 0);
+        }
+        char value[PROPERTY_VALUE_MAX] = {};
+        property_get(kDolbyEnabledProp, value, "0");
+        const bool dolbyOn = mDolbyHalOn || parseDolbyEnabledProp(value);
+        if (halChanged && dolbyOn) {
+            // Routing stays on deep_buffer but PAL may latch DSEE on the open stream.
+            mInvalidateMusicAfterUnlock = true;
+            finishDap = true;
+        }
+        updateBypassFromProperty_l();
+    }
+    runAfterRoutingUpdate();
+    if (finishDap) {
+        Mutex::Autolock _l(mLock);
+        finishDapRestartForPregain_l();
+    }
+}
+
+void EffectDapController::finishRoutingUpdate_l(bool dolbyOn) {
+    const bool dseeRoute = mDseeHalOn && (!dolbyOn || mUpmixSupportedPkg);
+    const bool dolbyMixerRoute = dolbyOn && !dseeRoute;
+    if (!mEffectiveRoutingInitialized) {
+        mEffectiveDolbyRoute = dolbyMixerRoute;
+        mEffectiveDseeRoute = dseeRoute;
+        mEffectiveRoutingInitialized = true;
+        return;
+    }
+    if (mEffectiveDseeRoute != dseeRoute) {
+        ALOGI("%s() dsee route changed %d->%d (dolby %d->%d), invalidate music",
+              __func__, mEffectiveDseeRoute ? 1 : 0, dseeRoute ? 1 : 0,
+              mEffectiveDolbyRoute ? 1 : 0, dolbyMixerRoute ? 1 : 0);
+        mEffectiveDseeRoute = dseeRoute;
+        mEffectiveDolbyRoute = dolbyMixerRoute;
+        mInvalidateMusicAfterUnlock = true;
+        return;
+    }
+    // Dolby mixer on/off stays on deep_buffer — stock does not invalidate for that alone.
+    mEffectiveDolbyRoute = dolbyMixerRoute;
+}
+
+void EffectDapController::runAfterRoutingUpdate() {
+    if (!mInvalidateMusicAfterUnlock) {
+        return;
+    }
+    mInvalidateMusicAfterUnlock = false;
+    if (mAudioFlinger != nullptr) {
+        mAudioFlinger->invalidateMusicTracksOnAllPlaybackThreads();
+    }
+}
+
+void EffectDapController::applyBypassState_l(bool dolbyOn) {
+    const bool bypass = !dolbyOn;
+    const bool changed = mBypassed != bypass;
+    mBypassed = bypass;
+    if (changed) {
+        ALOGI("%s() dolby_on=%d bypass=%d", __func__, dolbyOn ? 1 : 0, bypass ? 1 : 0);
+    }
+    // Stock: preg runs with Dolby OFF — do not push SET_BYPASS=1 from audioserver.
+    // HAL/dle_ds_state handles Dolby-off tuning; SET_BYPASS only when un-bypassing.
+    if (mDapEffect != nullptr && dolbyOn) {
+        setBypass_l(false);
+    }
+}
+
+void EffectDapController::updateBypassFromProperty_l() {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get(kDolbyEnabledProp, value, "0");
+    const bool dolbyOn = mDolbyHalOn || parseDolbyEnabledProp(value);
+    applyBypassState_l(dolbyOn);
+    updateEffectPriority_l();
+    finishRoutingUpdate_l(dolbyOn);
+}
+
+status_t EffectDapController::setBypass_l(bool bypass) {
+    sp<IAfEffectModule> effect = mDapEffect;
+    if (effect == nullptr) {
+        return NO_INIT;
+    }
+    const int32_t bypassVal = bypass ? 1 : 0;
+    status_t status = sendEffectIntParam(effect, EFFECT_PARAM_SET_BYPASS, bypassVal);
+    if (status != NO_ERROR) {
+        ALOGW("%s() SET_BYPASS failed: %d", __func__, status);
+    }
+
+    if (!bypass) {
+        status = sendEffectIntParam(effect, EFFECT_PARAM_SKIP_HARD_BYPASS, 1);
+        if (status != NO_ERROR) {
+            ALOGW("%s() SKIP_HARD_BYPASS failed: %d", __func__, status);
+        }
+    }
+    return status;
+}
+
+void EffectDapController::connectDmsIfNeeded(const sp<IAfThreadBase>& thread) {
+    if (mDmsClient == nullptr) {
+        return;
+    }
+    sp<IAfEffectModule> effect;
+    {
+        Mutex::Autolock _l(mLock);
+        effect = mDapEffect;
+    }
+    if (effect == nullptr) {
+        return;
+    }
+    const audio_session_t sessionId = effect->sessionId();
+    audio_io_handle_t ioHandle = AUDIO_IO_HANDLE_NONE;
+    if (thread != nullptr) {
+        ioHandle = thread->id();
+    }
+    if (ioHandle == AUDIO_IO_HANDLE_NONE) {
+        return;
+    }
+    const status_t status = mDmsClient->connect(sessionId, ioHandle);
+    if (status != NO_ERROR) {
+        ALOGW("%s() DMS connect failed: %d", __func__, status);
+    }
+}
+
+void EffectDapController::applyDapParamUpdate_l(const std::vector<uint8_t>& params) {
+    // Stock Sony audioserver does not relay DMS blobs through EFFECT_CMD_SET_PARAM.
+    (void)params;
+}
