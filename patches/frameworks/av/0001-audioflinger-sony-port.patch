+void PlaybackThread::resyncActiveTrackEffectVolumes_l() {
+    const float scaleTo8_24 =
+            static_cast<float>(MAX_GAIN_INT) * static_cast<float>(MAX_GAIN_INT);
+    for (const sp<IAfTrackBase>& trackBase : mActiveTracks) {
+        const sp<IAfTrack> track = trackBase->asIAfTrack();
+        if (track == nullptr) {
+            continue;
+        }
+        float left = 0.f;
+        float right = 0.f;
+        track->getFinalVolume(&left, &right);
+        if (left <= 0.f && right <= 0.f) {
+            continue;
+        }
+        uint32_t vl = static_cast<uint32_t>(scaleTo8_24 * left);
+        uint32_t vr = static_cast<uint32_t>(scaleTo8_24 * right);
+        sp<IAfEffectChain> chain = getEffectChain_l(track->sessionId());
+        if (chain != nullptr) {
+            chain->setVolume(&vl, &vr, true /* force */);
+        }
+    }
+}
