+constexpr const char* kDolbyEnabledProp = "persist.audio.dolby.enabled";
+constexpr nsecs_t kPregPrepMinIntervalNs = 50 * 1000000LL; // 50 ms debounce
+
+status_t sendEffectIntParam(const sp<IAfEffectModule>& effect, int32_t paramId, int32_t value) {
+    if (effect == nullptr) {
+        return NO_INIT;
+    }
+    uint8_t buf[sizeof(effect_param_t) + sizeof(int32_t) + sizeof(int32_t)] = {};
+    effect_param_t* p = reinterpret_cast<effect_param_t*>(buf);
+    p->psize = sizeof(int32_t);
+    p->vsize = sizeof(int32_t);
+    memcpy(p->data, &paramId, sizeof(int32_t));
+    memcpy(p->data + sizeof(int32_t), &value, sizeof(int32_t));
+    std::vector<uint8_t> cmd(buf, buf + sizeof(buf));
+    std::vector<uint8_t> reply;
+    return effect->command(EFFECT_CMD_SET_PARAM, cmd, sizeof(buf), &reply);
+}
+
+void* dolbyPropertyWatchEntry(void* /*arg*/) {
+    ALOGI("sony dolby bypass watcher started");
+    uint32_t serial = 0;
+    const prop_info* pi = nullptr;
+    while (EffectDapController::instance() != nullptr &&
+            EffectDapController::instance()->propertyWatcherRunning()) {
+        if (pi == nullptr) {
+            pi = __system_property_find(kDolbyEnabledProp);
+            if (pi == nullptr) {
+                usleep(500000);
+                continue;
+            }
+        }
+        uint32_t newSerial = serial;
+        const timespec timeout = {1, 0};
+        if (__system_property_wait(pi, serial, &newSerial, &timeout)) {
+            serial = newSerial;
+            if (EffectDapController* ctrl = EffectDapController::instance()) {
+                ctrl->updateBypassFromProperty();
+            }
+        }
+    }
+    return nullptr;
+}
+
+static std::vector<std::string> parseSomcPkgList(const char* list) {
+    std::vector<std::string> out;
+    if (list == nullptr || list[0] == '\0') {
+        return out;
+    }
+    const std::string s(list);
+    size_t start = 0;
+    for (size_t i = 0; i <= s.size(); ++i) {
+        if (i == s.size() || s[i] == ',' || s[i] == ';') {
+            if (i > start) {
+                std::string pkg = s.substr(start, i - start);
+                while (!pkg.empty() && pkg.front() == ' ') {
+                    pkg.erase(0, 1);
+                }
+                while (!pkg.empty() && pkg.back() == ' ') {
+                    pkg.pop_back();
+                }
+                if (!pkg.empty()) {
+                    out.push_back(pkg);
+                }
+            }
+            start = i + 1;
+        }
+    }
+    return out;
+}
+
+static bool pkgInSomcList(const std::string& pkg, const std::vector<std::string>& list) {
+    if (pkg.empty()) {
+        return false;
+    }
+    for (const auto& entry : list) {
+        if (entry == pkg) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace
+
+EffectDapController* EffectDapController::sInstance = nullptr;
+
+EffectDapController* EffectDapController::instance() {
+    return sInstance;
+}
+
+void EffectDapController::create(AudioFlinger* audioFlinger) {
+    if (sInstance == nullptr) {
+        sInstance = new EffectDapController();
+        sInstance->mAudioFlinger = audioFlinger;
+    }
+}
+
+EffectDapController::EffectDapController() {
+    mDmsClient = std::make_unique<EffectDapDmsClient>();
+    mDmsClient->setCallbacks(
+            [this](const std::vector<uint8_t>& params) {
+                Mutex::Autolock _l(mLock);
+                applyDapParamUpdate_l(params);
+            },
+            [this](bool dolbyOn) {
+                updateBypassFromDolbyHalState(dolbyOn);
+            });
+}
+
+void EffectDapController::onAudioFlingerReady() {
+    if (sInstance != nullptr) {
+        sInstance->startPropertyWatcher();
+        if (sInstance->mDmsClient != nullptr) {
+            sInstance->mDmsClient->refreshCachedState();
+        }
+    }
+}
+
+void EffectDapController::destroy() {
+    if (sInstance != nullptr) {
+        sInstance->stopPropertyWatcher();
+        if (sInstance->mDmsClient != nullptr) {
+            sInstance->mDmsClient->disconnect();
+        }
+    }
+    shutdownSonyMusicRoutingInvalidate();
+    delete sInstance;
+    sInstance = nullptr;
+}
+
+void EffectDapController::startPropertyWatcher() {
+    if (mPropWatchRunning.exchange(true)) {
+        return;
+    }
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    pthread_create(&mPropWatchThread, &attr, dolbyPropertyWatchEntry, nullptr);
+    pthread_attr_destroy(&attr);
+}
+
+void EffectDapController::stopPropertyWatcher() {
+    mPropWatchRunning.store(false);
+}
+
+bool EffectDapController::propertyWatcherRunning() const {
+    return mPropWatchRunning.load();
+}
+
+static bool parseDolbyEnabledProp(const char* value) {
+    if (value == nullptr || value[0] == '\0' || value[0] == '0') {
+        return false;
+    }
+    if (strcasecmp(value, "false") == 0) {
+        return false;
+    }
+    return true;
+}
+
+bool EffectDapController::isDapEffect(const sp<IAfEffectBase>& effect) {
+    if (effect == nullptr) {
+        return false;
+    }
+    static const effect_uuid_t kDapType = {
+        0x46d279d9, 0x9be7, 0x453d, 0x9d7c, {0xef, 0x93, 0x7f, 0x67, 0x55, 0x87}};
+    static const effect_uuid_t kDapSwUuid = {
+        0x9d4921da, 0x8225, 0x4f29, 0xaefa, {0x39, 0x53, 0x7a, 0x04, 0xbc, 0xaa}};
+    const effect_uuid_t& type = effect->desc().type;
+    const effect_uuid_t& uuid = effect->desc().uuid;
+    return memcmp(&type, &kDapType, sizeof(effect_uuid_t)) == 0
+            || memcmp(&type, &kDapSwUuid, sizeof(effect_uuid_t)) == 0
+            || memcmp(&uuid, &kDapSwUuid, sizeof(effect_uuid_t)) == 0;
+}
+
+bool EffectDapController::isUpmixEffect(const sp<IAfEffectBase>& effect) {
+    if (effect == nullptr) {
+        return false;
+    }
+    static const effect_uuid_t kUpmixUuid = {
+        0xeced456e, 0xa166, 0xfcf1, 0x5c7b, {0x44, 0xa2, 0x70, 0x1d, 0xaa, 0x1c}};
+    return memcmp(&effect->desc().uuid, &kUpmixUuid, sizeof(effect_uuid_t)) == 0
+            || memcmp(&effect->desc().type, &kUpmixUuid, sizeof(effect_uuid_t)) == 0;
+}
+
+status_t EffectDapController::setSkipEffectProcess_l(const sp<IAfEffectModule>& effect, bool skip) {
+    if (effect == nullptr) {
+        return NO_INIT;
+    }
+    effect->setSkipEffectProcess(skip);
+    return NO_ERROR;
+}
+
+bool EffectDapController::isPlayingPkgPrioritized_l() const {
+    if (pkgInSomcList(mPlayingPkgName, mExcludedApps)) {
+        return false;
+    }
+    if (pkgInSomcList(mPlayingPkgName, mPrioritizedApps)) {
+        return true;
+    }
+    if (mPlayingPkgUid == static_cast<uid_t>(-1) || mPlayingPkgUid == 0) {
+        return false;
+    }
+    PermissionController permissionController;
+    for (const auto& pkg : mPrioritizedApps) {
+        const int pkgUid = permissionController.getPackageUid(String16(pkg.c_str()), 0);
+        if (pkgUid >= 0 && static_cast<uid_t>(pkgUid) == mPlayingPkgUid) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool EffectDapController::queryUpmixSupportedPkg_l() {
+    if (isPlayingPkgPrioritized_l()) {
+        ALOGI("%s: Upmix Supported Pkg status cached: prioritized list", __func__);
+        return true;
+    }
+    if (mAudioFlinger == nullptr) {
+        return false;
+    }
+    const String8 result = mAudioFlinger->querySonyHalParameters(String8("isUpmixSupportedPkg"));
+    if (result.length() == 0) {
+        return false;
+    }
+    AudioParameter param(result);
+    int value = 0;
+    if (param.getInt(String8("isUpmixSupportedPkg"), value) == NO_ERROR) {
+        const bool supported = value != 0;
+        ALOGI("%s: Upmix Supported Pkg status cached: HAL=%d", __func__, supported ? 1 : 0);
+        return supported;
+    }
+    String8 str;
+    if (param.get(String8("isUpmixSupportedPkg"), str) == NO_ERROR) {
+        const bool supported = str == "1" || str == "true";
+        ALOGI("%s: Upmix Supported Pkg status cached: HAL=%s", __func__, str.c_str());
+        return supported;
+    }
+    return false;
+}
+
+void EffectDapController::updateEffectPriority_l() {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get(kDolbyEnabledProp, value, "0");
+    const bool dolbyActive = mDolbyHalOn || parseDolbyEnabledProp(value);
+    const bool upmixModeOn = mUpmixHeadphoneMode != 0;
+    const bool native360 = m360raContents;
+    const bool sonySonyActive = upmixModeOn || mDseeHalOn || native360;
+    // Stock: 360 and DSEE share the same Dolby arbitration via effect priority.
+    const bool sonyWinsOverDolby = sonySonyActive &&
+            (!dolbyActive || mUpmixSupportedPkg);
+    const bool dapSkip = native360 || !dolbyActive || sonyWinsOverDolby;
+    const bool upmixSkip = !upmixModeOn || (dolbyActive && !native360 && !mUpmixSupportedPkg);
+
+    if (mDapEffect != nullptr) {
+        setSkipEffectProcess_l(mDapEffect, dapSkip);
+    }
+    if (mUpmixEffect != nullptr) {
+        setSkipEffectProcess_l(mUpmixEffect, upmixSkip);
+    }
+
+    const char* dapStatus = dapSkip ? "dolby non-Prioritized" : "dolby Prioritized";
+    const char* upmixStatus = upmixSkip ? "upmix non-Prioritized" : "upmix Prioritized";
+  const char* pkgStatus = mUpmixSupportedPkg ? "Upmix Supported Pkg" : "Upmix non-Supported Pkg";
+    ALOGI("%s() mode=%d dolby=%d dsee=%d 360ra=%d upmixPkg=%d uid=%u -> %s / %s (%s)",
+          __func__, mUpmixHeadphoneMode, dolbyActive ? 1 : 0, mDseeHalOn ? 1 : 0,
+          native360 ? 1 : 0, mUpmixSupportedPkg ? 1 : 0, mPlayingPkgUid, dapStatus,
+          upmixStatus, pkgStatus);
+}
+
+void EffectDapController::onUpmixHeadphoneMode(int mode) {
+    Mutex::Autolock _l(mLock);
+    if (mUpmixHeadphoneMode == mode) {
+        return;
+    }
+    mUpmixHeadphoneMode = mode;
+    updateEffectPriority_l();
+}
+
+int EffectDapController::upmixHeadphoneMode() const {
+    Mutex::Autolock _l(mLock);
+    return mUpmixHeadphoneMode;
+}
+
+void EffectDapController::on360RaContents(bool active) {
+    Mutex::Autolock _l(mLock);
+    if (m360raContents == active) {
+        return;
+    }
+    m360raContents = active;
+    ALOGI("%s: 360ra_contents=%d", __func__, active ? 1 : 0);
+    updateEffectPriority_l();
+}
+
+void EffectDapController::onUpmixPlayingPkg(uid_t uid, const char* packageName) {
+    {
+        Mutex::Autolock _l(mLock);
+        mPlayingPkgUid = uid;
+        if (packageName != nullptr && packageName[0] != '\0') {
+            mPlayingPkgName = packageName;
+            ALOGI("%s: uid=%u pkg=%s", __func__, uid, packageName);
+        } else {
+            mPlayingPkgName.clear();
+            ALOGI("%s: uid=%u", __func__, uid);
+        }
+        mUpmixSupportedPkg = queryUpmixSupportedPkg_l();
+        updateEffectPriority_l();
+        char value[PROPERTY_VALUE_MAX] = {};
+        property_get(kDolbyEnabledProp, value, "0");
+        const bool dolbyOn = mDolbyHalOn || parseDolbyEnabledProp(value);
+        finishRoutingUpdate_l(dolbyOn);
+    }
+    runAfterRoutingUpdate();
+}
+
+void EffectDapController::onSomcPrioritizedApps(const char* prioritizedApps) {
+    {
+        Mutex::Autolock _l(mLock);
+        mPrioritizedApps = parseSomcPkgList(prioritizedApps);
+        ALOGI("%s: prioritized=%zu playing_pkg=%s", __func__, mPrioritizedApps.size(),
+              mPlayingPkgName.empty() ? "(none)" : mPlayingPkgName.c_str());
+        mUpmixSupportedPkg = queryUpmixSupportedPkg_l();
+        updateEffectPriority_l();
+        mInvalidateMusicAfterUnlock = true;
+    }
+    runAfterRoutingUpdate();
+}
+
+void EffectDapController::onSomcExcludedApps(const char* excludedApps) {
+    {
+        Mutex::Autolock _l(mLock);
+        mExcludedApps = parseSomcPkgList(excludedApps);
+        ALOGI("%s: excluded=%zu playing_pkg=%s", __func__, mExcludedApps.size(),
+              mPlayingPkgName.empty() ? "(none)" : mPlayingPkgName.c_str());
+        mUpmixSupportedPkg = queryUpmixSupportedPkg_l();
+        updateEffectPriority_l();
+        mInvalidateMusicAfterUnlock = true;
+    }
+    runAfterRoutingUpdate();
+}
+
+void EffectDapController::onSomcAppLists(const char* prioritizedApps, const char* excludedApps) {
+    onSomcPrioritizedApps(prioritizedApps);
+    onSomcExcludedApps(excludedApps);
+}
