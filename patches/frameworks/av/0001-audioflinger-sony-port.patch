+
+#include <functional>
+#include <memory>
+#include <vector>
+
+namespace android {
+
+class EffectDapDmsClient {
+public:
+    using ParamUpdateFn = std::function<void(const std::vector<uint8_t>& params)>;
+    using DolbyStateFn = std::function<void(bool dolbyOn)>;
+
+    EffectDapDmsClient();
+    ~EffectDapDmsClient();
+
+    void setCallbacks(ParamUpdateFn onParamUpdate, DolbyStateFn onDolbyState);
+
+    status_t connect(audio_session_t sessionId, audio_io_handle_t ioHandle);
+    void disconnect();
+    void refreshCachedState();
+
+private:
+    friend struct HidlState;
+
+    void onDapParamUpdate(const std::vector<uint8_t>& params);
+    void onServiceDied();
+    void disconnectLocked() REQUIRES(mLock);
+    void refreshCachedStateLocked() REQUIRES(mLock);
+
+    struct HidlState;
+    std::unique_ptr<HidlState> mHidl;
+
+    Mutex mLock;
+    ParamUpdateFn mOnParamUpdate;
+    DolbyStateFn mOnDolbyState;
+    audio_session_t mSessionId = AUDIO_SESSION_NONE;
+    audio_io_handle_t mIoHandle = AUDIO_IO_HANDLE_NONE;
+    bool mRegistered = false;
+};
+
+} // namespace android
