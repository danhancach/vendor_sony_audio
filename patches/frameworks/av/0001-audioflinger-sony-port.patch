new file mode 100644
index 0000000000..76b8297285
--- /dev/null
+++ b/services/audioflinger/SonyRoutingInvalidate.cpp
@@ -0,0 +1,140 @@
+/*
+ * Stock libar-pal coalesces invalidate_out_track via a worker thread with
+ * vendor.audio.invalidate_sleep_{before,after,dsee_on} and
+ * vendor.audio.invalidate_skip to defer framework invalidate to HAL-only.
+ */
+#define LOG_TAG "SonyRoutingInvalidate"
+
+#include "SonyRoutingInvalidate.h"
+
+#include "AudioFlinger.h"
+
+#include <cutils/properties.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <utils/Log.h>
+
+#include <atomic>
+
+namespace android {
+
+namespace {
+
+constexpr int kDefaultSleepBeforeUs = 100000;  // shorter than HAL 300ms — framework leads reroute
+constexpr int kDefaultSleepAfterUs = 0;
+
+std::atomic<uint32_t> gRequestId{0};
+std::atomic<uint32_t> gPendingId{0};
+std::atomic<bool> gWorkerRunning{false};
+std::atomic<bool> gInvalidateAllTracks{false};
+std::atomic<int> gSleepBeforeUsOverride{-1};
+pthread_t gWorkerThread{};
+pthread_mutex_t gMutex = PTHREAD_MUTEX_INITIALIZER;
+pthread_cond_t gCond = PTHREAD_COND_INITIALIZER;
+AudioFlinger* gAudioFlinger = nullptr;
+
+int sonySleepUs(const char* prop, int defaultUs) {
+    const int value = property_get_int32(prop, defaultUs);
+    return value > 0 ? value : 0;
+}
+
+bool sonyFrameworkInvalidateSkipped() {
+    return property_get_bool("vendor.audio.invalidate_skip", false);
+}
+
+void* workerEntry(void* /*arg*/) {
+    while (gWorkerRunning.load()) {
+        uint32_t reqId = 0;
+        int sleepBeforeOverride = -1;
+        {
+            pthread_mutex_lock(&gMutex);
+            while (gWorkerRunning.load() && gPendingId.load() == 0) {
+                pthread_cond_wait(&gCond, &gMutex);
+            }
+            if (!gWorkerRunning.load()) {
+                pthread_mutex_unlock(&gMutex);
+                break;
+            }
+            reqId = gPendingId.exchange(0);
+            sleepBeforeOverride = gSleepBeforeUsOverride.exchange(-1);
+            pthread_mutex_unlock(&gMutex);
+        }
+
+        if (reqId == 0 || sonyFrameworkInvalidateSkipped()) {
+            ALOGV("%s: skip framework invalidate req=%u (hal-only)", __func__, reqId);
+            continue;
+        }
+
+        const int sleepBefore = sleepBeforeOverride >= 0
+                ? sleepBeforeOverride
+                : sonySleepUs("vendor.audio.invalidate_sleep_before", kDefaultSleepBeforeUs);
+        if (sleepBefore > 0) {
+            usleep(static_cast<useconds_t>(sleepBefore));
+        }
+        if (gRequestId.load() != reqId) {
+            ALOGV("%s: coalesced req=%u", __func__, reqId);
+            continue;
+        }
+
+        AudioFlinger* af = gAudioFlinger;
+        if (af != nullptr) {
+            const bool invalidateAll = gInvalidateAllTracks.exchange(false);
+            ALOGI("%s: invalidate music tracks req=%u all=%d sleep_before=%dus", __func__, reqId,
+                  invalidateAll ? 1 : 0, sleepBefore);
+            af->invalidateMusicStreamsForSonyRouting(invalidateAll);
+        }
+
+        const int sleepAfter =
+                sonySleepUs("vendor.audio.invalidate_sleep_after", kDefaultSleepAfterUs);
+        if (sleepAfter > 0 && gRequestId.load() == reqId) {
+            usleep(static_cast<useconds_t>(sleepAfter));
+        }
+    }
+    return nullptr;
+}
+
+void ensureWorkerStarted() {
+    if (gWorkerRunning.exchange(true)) {
+        return;
+    }
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    pthread_create(&gWorkerThread, &attr, workerEntry, nullptr);
+    pthread_attr_destroy(&attr);
+}
+
+}  // namespace
+
+void scheduleSonyMusicRoutingInvalidate(AudioFlinger* audioFlinger, bool invalidateAll,
+                                        int sleepBeforeUsOverride) {
+    if (audioFlinger == nullptr) {
+        return;
+    }
+    gAudioFlinger = audioFlinger;
+    if (invalidateAll) {
+        gInvalidateAllTracks.store(true);
+    }
+    if (sleepBeforeUsOverride >= 0) {
+        const int prev = gSleepBeforeUsOverride.load();
+        if (prev < 0 || sleepBeforeUsOverride < prev) {
+            gSleepBeforeUsOverride.store(sleepBeforeUsOverride);
+        }
+    }
+    const uint32_t reqId = gRequestId.fetch_add(1) + 1;
+    gPendingId.store(reqId);
+    ensureWorkerStarted();
+    pthread_mutex_lock(&gMutex);
+    pthread_cond_signal(&gCond);
+    pthread_mutex_unlock(&gMutex);
+}
+
+void shutdownSonyMusicRoutingInvalidate() {
+    gWorkerRunning.store(false);
+    pthread_mutex_lock(&gMutex);
+    pthread_cond_signal(&gCond);
+    pthread_mutex_unlock(&gMutex);
+    gAudioFlinger = nullptr;
+}
+
+}  // namespace android
