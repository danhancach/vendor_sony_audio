index 0000000000..3573f37667
--- /dev/null
+++ b/services/audioflinger/EffectDapDmsClient.cpp
@@ -0,0 +1,191 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#define LOG_TAG "EffectDapDmsClient"
+
+#include "EffectDapDmsClient.h"
+
+#include "ds_config.h"
+
+#include <android/hidl/base/1.0/IBase.h>
+#include <hidl/HidlSupport.h>
+#include <hidl/HidlTransportSupport.h>
+#include <utils/Log.h>
+#include <vendor/dolby/hardware/dms/2.0/IDms.h>
+#include <vendor/dolby/hardware/dms/2.0/IDmsCallbacks.h>
+
+namespace android {
+
+using ::android::hardware::hidl_death_recipient;
+using ::android::hardware::hidl_vec;
+using ::android::hardware::Return;
+using ::android::hardware::Void;
+using ::vendor::dolby::hardware::dms::V2_0::IDms;
+using ::vendor::dolby::hardware::dms::V2_0::IDmsCallbacks;
+
+namespace {
+
+const char* kDmsServiceName = "default";
+
+const char* dolbyEffectOnLabel(int64_t value) {
+    return value != 0 ? "on" : "off";
+}
+
+} // namespace
+
+struct EffectDapDmsClient::HidlState {
+    class Callbacks : public IDmsCallbacks {
+    public:
+        explicit Callbacks(EffectDapDmsClient* owner) : mOwner(owner) {}
+
+        Return<void> onDapParamUpdate(const hidl_vec<uint8_t>& params) override {
+            if (mOwner == nullptr) {
+                return Void();
+            }
+            std::vector<uint8_t> copy(params.begin(), params.end());
+            mOwner->onDapParamUpdate(copy);
+            return Void();
+        }
+
+    private:
+        EffectDapDmsClient* mOwner;
+    };
+
+    class ServiceDeathRecipient : public hidl_death_recipient {
+    public:
+        explicit ServiceDeathRecipient(EffectDapDmsClient* owner) : mOwner(owner) {}
+
+        void serviceDied(uint64_t /*cookie*/,
+                const wp<::android::hidl::base::V1_0::IBase>& /*who*/) override {
+            ALOGW("%s() DMS service died", __func__);
+            if (mOwner != nullptr) {
+                mOwner->onServiceDied();
+            }
+        }
+
+    private:
+        EffectDapDmsClient* mOwner;
+    };
+
+    sp<IDms> service;
+    sp<Callbacks> callbacks;
+    sp<ServiceDeathRecipient> deathRecipient;
+};
+
+EffectDapDmsClient::EffectDapDmsClient() = default;
+
+EffectDapDmsClient::~EffectDapDmsClient() {
+    disconnect();
+}
+
+void EffectDapDmsClient::setCallbacks(ParamUpdateFn onParamUpdate, DolbyStateFn onDolbyState) {
+    Mutex::Autolock _l(mLock);
+    mOnParamUpdate = std::move(onParamUpdate);
+    mOnDolbyState = std::move(onDolbyState);
+}
+
+status_t EffectDapDmsClient::connect(audio_session_t sessionId, audio_io_handle_t ioHandle) {
+    Mutex::Autolock _l(mLock);
+    if (mRegistered && mSessionId == sessionId && mIoHandle == ioHandle) {
+        return NO_ERROR;
+    }
+    if (mRegistered) {
+        disconnectLocked();
+    }
+
+    if (mHidl == nullptr) {
+        mHidl = std::make_unique<HidlState>();
+        mHidl->callbacks = new HidlState::Callbacks(this);
+        mHidl->deathRecipient = new HidlState::ServiceDeathRecipient(this);
+    }
+
+    mHidl->service = IDms::tryGetService(kDmsServiceName);
+    if (mHidl->service == nullptr) {
+        ALOGW("%s Cannot get Dolby manager service.", __func__);
+        return NO_INIT;
+    }
+
+    Return<bool> linkStatus = mHidl->service->linkToDeath(mHidl->deathRecipient, 0);
+    ALOGI("registerClient() linkToDeath = %d", linkStatus.isOk() && linkStatus ? 1 : 0);
+
+    mHidl->service->registerClient(mHidl->callbacks, static_cast<int32_t>(sessionId),
+            static_cast<int32_t>(ioHandle));
+    mSessionId = sessionId;
+    mIoHandle = ioHandle;
+    mRegistered = true;
+    ALOGI("%s() registered session=%d io=%d", __func__, sessionId, ioHandle);
+    refreshCachedStateLocked();
+    return NO_ERROR;
+}
+
+void EffectDapDmsClient::disconnect() {
+    Mutex::Autolock _l(mLock);
+    disconnectLocked();
+}
+
+void EffectDapDmsClient::refreshCachedState() {
+    Mutex::Autolock _l(mLock);
+    refreshCachedStateLocked();
+}
+
+void EffectDapDmsClient::onDapParamUpdate(const std::vector<uint8_t>& params) {
+    ParamUpdateFn cb;
+    {
+        Mutex::Autolock _l(mLock);
+        cb = mOnParamUpdate;
+    }
+    if (cb) {
+        cb(params);
+    }
+}
+
+void EffectDapDmsClient::onServiceDied() {
+    Mutex::Autolock _l(mLock);
+    if (mHidl != nullptr) {
+        mHidl->service.clear();
+    }
+    mRegistered = false;
+}
+
+void EffectDapDmsClient::disconnectLocked() {
+    if (!mRegistered || mHidl == nullptr || mHidl->service == nullptr ||
+            mHidl->callbacks == nullptr) {
+        mRegistered = false;
+        mSessionId = AUDIO_SESSION_NONE;
+        mIoHandle = AUDIO_IO_HANDLE_NONE;
+        return;
+    }
+    mHidl->service->unregisterClient(mHidl->callbacks, static_cast<int32_t>(mSessionId),
+            static_cast<int32_t>(mIoHandle));
+    mHidl->service->unlinkToDeath(mHidl->deathRecipient);
+    mRegistered = false;
+    mSessionId = AUDIO_SESSION_NONE;
+    mIoHandle = AUDIO_IO_HANDLE_NONE;
+}
+
+void EffectDapDmsClient::refreshCachedStateLocked() {
+    if (mHidl == nullptr || mHidl->service == nullptr) {
+        return;
+    }
+    DolbyStateFn stateCb = mOnDolbyState;
+
+    auto query = [&](int32_t paramId, const char* label) {
+        auto result = mHidl->service->getIntParam(paramId);
+        if (!result.isOk()) {
+            ALOGW("%s() getIntParam(%d) failed: %s", __func__, paramId,
+                    result.description().c_str());
+            return;
+        }
+        const int64_t value = result;
+        ALOGI("  %s status cached: %s", label, dolbyEffectOnLabel(value));
+        if (paramId == DMS_INT_PARAM_DOLBY_EFFECT_ON && stateCb) {
+            stateCb(value != 0);
+        }
+    };
+
+    query(DMS_INT_PARAM_DOLBY_EFFECT_ON, "DolbyEffect On");
+    query(DMS_INT_PARAM_DOLBY_CONTENTS, "Dolby Contents");
+    query(DMS_INT_PARAM_DOLBY_PRIORITIZED, "Dolby Prioritized");
+}
+
+} // namespace android
